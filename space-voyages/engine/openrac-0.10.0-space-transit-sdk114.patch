+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "openrac/openrac_mod.h"
+static const openrac_api* api;
+static openrac_mod* mod;
+static void (*record)(int);
+static openrac_transient_source source;
+static uint32_t last_clip, voice;
+static int failures, closing_count;
+#define REQUIRE(x) do{if(!(x))++failures;}while(0)
+static int tick(void* user,float seconds,uint16_t held,const uint8_t analog[4]){
+    (void)user;(void)seconds;(void)held;(void)analog;
+    static const int16_t samples[]={1000,2000,3000,4000};
+    openrac_transient_audio_pcm pcm={sizeof(pcm),48000,1,samples,4,1,4};
+    openrac_transient_audio_params p={sizeof(p),OPENRAC_TRANSIENT_AUDIO_LOOP,0,1,1,0};
+    if(last_clip)REQUIRE(api->transient_audio_play(mod,last_clip,&p)==0);
+    REQUIRE(api->transient_run(mod,&source)==OPENRAC_HOOK_TAKEN);
+    REQUIRE(api->transient_audio_create(NULL,&pcm)==0);
+    REQUIRE(api->transient_audio_pause(NULL,1)==OPENRAC_HOOK_UNKNOWN);
+    last_clip=api->transient_audio_create(mod,&pcm);REQUIRE(last_clip!=0);
+    voice=api->transient_audio_play(mod,last_clip,&p);REQUIRE(voice&&api->transient_audio_playing(mod,voice));
+    REQUIRE(api->transient_audio_pause(mod,1)==OPENRAC_HOOK_OK);
+    REQUIRE(api->transient_audio_set(mod,voice,&p)==OPENRAC_HOOK_OK);
+    REQUIRE(api->transient_audio_pause(mod,0)==OPENRAC_HOOK_OK);
+    openrac_transient_audio_stats stats={0};stats.size=sizeof(stats);
+    REQUIRE(api->transient_audio_stats(mod,&stats)==OPENRAC_HOOK_OK&&stats.clips==1&&stats.voices==1);
+    return 0;
+}
+static void draw(void* user,int w,int h){(void)user;(void)w;(void)h;}
+static void closing(void* user){(void)user;++closing_count;REQUIRE(api->transient_audio_playing(mod,voice)==1);}
+static void frame(void* user){
+    (void)user;failures=0;
+    source.size=sizeof(source);source.tick=tick;source.draw=draw;source.closing=closing;
+    REQUIRE(api->transient_audio_stop(mod,0)==OPENRAC_HOOK_UNKNOWN);
+    const int result=api->transient_run(mod,&source);
+    REQUIRE(!api->transient_audio_playing(mod,voice));
+    record(failures?failures:result==OPENRAC_HOOK_OK?100:200);
+}
+OPENRAC_MOD_DEFINE("transient-audio-test","1.0.0")
+OPENRAC_MOD_EXPORT int openrac_mod_load(const openrac_api* host,openrac_mod* owner){
+    api=host;mod=owner;record=(void(*)(int))api->function("Test_Record");
+    if(!record||api->api_minor<13)return 1;
+    return api->on_frame(mod,frame,NULL)==OPENRAC_HOOK_OK?0:1;
+}
diff --git a/port/tests/mod_transient_test.cpp b/port/tests/mod_transient_test.cpp
