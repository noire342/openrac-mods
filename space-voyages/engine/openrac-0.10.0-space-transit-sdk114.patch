@@ -90,6 +90,44 @@ renderer::Mat4 rotation_z(float a) {
 
 }  // namespace
 
+bool read_cinematic_cut(std::span<const std::uint8_t> ram, const CinematicAddresses& a) {
+    const auto range = [&](std::uint32_t address, std::size_t bytes) {
+        return address >= 0x10000u && address <= ram.size() && bytes <= ram.size() - address;
+    };
+    if (!range(a.mode,4) || !range(a.ship,0x2A) || !range(a.playback,0x60)
+        || !range(a.pal_mode,4) || at<std::int32_t>(ram,a.mode) != 6) return false;
+    const auto state=at<std::int32_t>(ram,a.ship+0x20);
+    if (state != 0 && state != 8) return false;
+    const auto timing=at<std::int32_t>(ram,a.pal_mode);
+    if (timing != 0 && timing != 1) return false;
+    const auto ticks=timing ? 80 : 96;
+    const auto time=at<std::int32_t>(ram,a.playback+0x34);
+    const auto frame=at<std::int32_t>(ram,a.playback+0x38);
+    const auto bank=at<std::int32_t>(ram,a.playback+0x3C);
+    const auto end=at<std::int16_t>(ram,a.playback+0x40);
+    const auto actors=at<std::int16_t>(ram,a.playback+0x44);
+    // Cleanup retires the bank/actors before drawing. Do not inspect their
+    // pointers at end, even when a previous flagged camera remains in RAM.
+    if (time < 0 || time >= end || end <= 0 || end > 70*ticks || bank < 0 || bank >= 70
+        || frame < 0 || frame >= ticks || time != bank*ticks+frame
+        || actors <= 0 || actors > 18) return false;
+    const auto record=at<std::uint32_t>(ram,a.playback+0x58);
+    const auto frames=at<std::uint32_t>(ram,a.playback+0x54);
+    if (!range(record,0x14+4*std::size_t(actors)) || (record&0xFu) != 0 || (frames&0xFu) != 0)
+        return false;
+    const auto camera_offset=at<std::uint32_t>(ram,record+0x10);
+    if (at<std::uint16_t>(ram,record) != end
+        || at<std::uint16_t>(ram,record+0xC) != actors
+        || camera_offset < 0x14+4*std::uint32_t(actors)
+        || camera_offset > ram.size()-record || frames != record+camera_offset
+        || !range(frames,32*std::size_t(frame+1))) return false;
+    const auto key=frames+32*std::uint32_t(frame);
+    for (const auto offset : {0u,4u,8u,16u,20u,24u,28u})
+        if (!std::isfinite(at<float>(ram,key+offset))) return false;
+    const auto fov=at<float>(ram,key+28);
+    return fov > .05f && fov < 10.f && at<std::uint8_t>(ram,key+12) != 0;
+}
