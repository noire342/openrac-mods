diff --git a/port/game/common/program/destination_registry.cpp b/port/game/common/program/destination_registry.cpp
new file mode 100644
index 00000000..869a81a0
--- /dev/null
+++ b/port/game/common/program/destination_registry.cpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "mod_destination.h"
+#include "openrac/game_host.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+namespace openrac::program {
+namespace {
+constexpr std::uint64_t added_base = 0x100000000ULL;
+int level() { return openrac_game_loaded_overlay(); }
+std::uint32_t generation() {
+    return openrac_game_play_host && openrac_game_play_host->loads ? openrac_game_play_host->loads() : 0;
+}
+bool program_exists(int program) {
+    return openrac_game_front_end && program >= 0 && program < openrac_game_front_end->levels &&
+           openrac_game_has_level(program);
+}
+int campaign(int program, openrac_destination* out) {
+    if (!out || out->size < sizeof *out || !program_exists(program)) return 0;
+    openrac_destination copy{}; copy.size = sizeof copy;
+    copy.kind = OPENRAC_DESTINATION_CAMPAIGN; copy.handle = std::uint64_t(program) + 1;
+    copy.registry_generation = openrac_game_destination_registry_generation;
+    copy.native_level = program;
+    const char* label = openrac_game_play_host && openrac_game_play_host->level_names ?
+                        openrac_game_play_host->level_names[program] : nullptr;
+    std::snprintf(copy.name, sizeof copy.name, "%s", label ? label : "Campaign");
+    *out = copy; return 1;
+}
+int added(unsigned index, openrac_destination* out) {
+    if (!out || out->size < sizeof *out || index >= openrac_game_destination_count ||
+        !openrac_game_destinations) return 0;
+    const auto& map = openrac_game_destinations[index];
+    if (!map.manifest_id || !map.manifest_id[0] || !program_exists(map.level)) return 0;
+    openrac_destination copy{}; copy.size = sizeof copy; copy.kind = OPENRAC_DESTINATION_ADDED;
+    copy.handle = added_base + index + 1;
+    copy.registry_generation = openrac_game_destination_registry_generation;
+    copy.native_level = map.level;
+    std::snprintf(copy.manifest_id, sizeof copy.manifest_id, "%s", map.manifest_id);
+    std::snprintf(copy.name, sizeof copy.name, "%s", map.name ? map.name : map.manifest_id);
+    *out = copy; return 1;
+}
+int lookup(const char* id, openrac_destination* out) {
+    if (!id || !id[0] || !out || out->size < sizeof *out) return 0;
+    for (unsigned index = 0; index < openrac_game_destination_count; ++index) {
+        const char* installed = openrac_game_destinations[index].manifest_id;
+        if (installed && std::strcmp(id, installed) == 0) return added(index, out);
+    }
+    return 0;
+}
+int resolve(std::uint64_t registry, std::uint64_t handle, openrac_destination* out) {
+    if (registry != openrac_game_destination_registry_generation || !handle) return 0;
+    if (handle < added_base) return handle <= 0x7fffffffULL ? campaign(int(handle - 1), out) : 0;
+    const auto index = handle - added_base - 1;
+    return index < openrac_game_destination_count ? added(unsigned(index), out) : 0;
+}
+int current(openrac_destination_context* out) {
+    if (!out || out->size < sizeof *out) return 0;
+    openrac_destination_context copy{}; copy.size = sizeof copy;
+    copy.native_generation = generation(); copy.origin.size = sizeof copy.origin;
+    const int index = openrac_game_active_destination;
+    if (index >= 0) {
+        if (!added(unsigned(index), &copy.origin)) return 0;
+    } else {
+        // A standalone map is not the campaign and has no registry identity.
+        if (openrac_game_map || !campaign(level(), &copy.origin)) return 0;
+    }
+    if (copy.origin.native_level != level()) return 0;
+    *out = copy; return 1;
+}
+int ready() {
+    return openrac_game_play_host && openrac_game_play_host->destination_departure_ready &&
+           openrac_game_play_host->destination_departure_ready();
+}
+int mount(const openrac_destination* wanted) {
+    if (!wanted) return 0;
+    openrac_destination checked{}; checked.size = sizeof checked;
+    if (!resolve(wanted->registry_generation, wanted->handle, &checked) ||
+        wanted->kind != checked.kind || wanted->native_level != checked.native_level ||
+        std::strcmp(wanted->manifest_id, checked.manifest_id) != 0) return 0;
+    const int index = checked.kind == OPENRAC_DESTINATION_ADDED ? int(checked.handle - added_base - 1) : -1;
+    // No extra generation change for a return to the same logical origin.
+    if (openrac_game_active_destination != index) openrac_game_select_destination(index);
+    return 1;
+}
+const mods::DestinationHost host{lookup, campaign, resolve, current, ready, level, generation, mount};
+}
+const mods::DestinationHost* destination_host() { return &host; }
+} // namespace openrac::program
