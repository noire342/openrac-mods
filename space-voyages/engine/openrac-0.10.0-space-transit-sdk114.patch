+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#include "openrac/openrac_mod.h"
+
+namespace openrac::mods {
+// One synchronous lease; a nested request must never steal its callbacks.
+class TransientLease {
+public:
+    bool acquire(const void* owner, const openrac_transient_source* source) {
+        constexpr auto prefix = offsetof(openrac_transient_source, draw_interpolated);
+        if (owner_ || !owner || !source || source->size < prefix) {
+            return false;
+        }
+        openrac_transient_source copy{};
+        std::memcpy(&copy, source, std::min<std::size_t>(source->size, sizeof copy));
+        if (source->size < sizeof copy) {
+            copy.draw_interpolated = nullptr;
+        }
+        if (!copy.tick || (!copy.draw && !copy.draw_interpolated)) {
+            return false;
+        }
+        owner_ = owner;
+        source_ = copy;
+        return true;
+    }
+
+    void release() {
+        owner_ = nullptr;
+        source_ = {};
+    }
+
+    bool active() const { return owner_ != nullptr; }
+    bool owns(const void* owner)const{return owner&&owner==owner_;}
+    const void* owner()const{return owner_;}
+
+    const openrac_transient_source& source() const { return source_; }
+
+private:
+    const void* owner_{};
+    openrac_transient_source source_{};
+};
+}  // namespace openrac::mods
