+// Native fades and incomplete display lists resume from the picture shown last. The temporary
+// scene owns a separate target, so hand that picture to every native retained surface before
+// returning. A textured draw also reaches multisampled native targets and differing render scales;
+// a single-sample framebuffer blit cannot do both.
+void retain_transient_picture(const renderer::FrameBuffer& picture) {
+    using namespace gl;
+    std::string error;
+    if (!g->frame.id() && !g->frame.create(picture.width(), picture.height(), error)) {
+        throw std::runtime_error(error);
+    }
+    const int width = g->frame.width(), height = g->frame.height();
+    if ((g->last_world.width() != width || g->last_world.height() != height)
+        && !g->last_world.create(width, height, error)) {
+        throw std::runtime_error(error);
+    }
+    renderer::Shader copy;
+    constexpr auto vertex = R"(#version 410 core
+out vec2 uv;
+void main() {
+    vec2 corner = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    uv = corner;
+    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);
+})";
+    constexpr auto fragment = R"(#version 410 core
+in vec2 uv;
+uniform sampler2D tex_T0;
+out vec4 colour;
+void main() { colour = texture(tex_T0, uv); }
+)";
+    if (!copy.build("transient handoff", vertex, fragment, error)) {
+        throw std::runtime_error(error);
+    }
+    // Resolve before binding its texture: Vulkan's multisample-to-texture path finalizes it here.
+    picture.resolved();
+    unsigned vao = 0;
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_SCISSOR_TEST);
+    glDepthMask(GL_FALSE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glActiveTexture(GL_TEXTURE0);
+    glBindSampler(0, 0);
+    glBindTexture(GL_TEXTURE_2D, picture.colour_texture());
+    copy.use();
+    const auto draw = [](unsigned target, int w, int h) {
+        glBindFramebuffer(GL_FRAMEBUFFER, target);
+        glViewport(0, 0, w, h);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    };
+    draw(g->frame.id(), width, height);
+    draw(g->last_world.id(), width, height);
+    // A menu may have already read the previous frame into its own texture.
+    const auto& snapshot = renderer::g_frame_snapshot;
+    if (snapshot.texture != 0 && snapshot.width > 0 && snapshot.height > 0) {
+        unsigned target = 0;
+        glGenFramebuffers(1, &target);
+        glBindFramebuffer(GL_FRAMEBUFFER, target);
+        glFramebufferTexture2D(
+            GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, snapshot.texture, 0
+        );
+        draw(target, snapshot.width, snapshot.height);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glDeleteFramebuffers(1, &target);
+    }
+    glBindVertexArray(0);
+    glDeleteVertexArrays(1, &vao);
+    glDepthMask(GL_TRUE);
+    g->hold_last_world = false;
+    g->last_tick_menu = false;
+    g->last_world_tick = g->index;
+    if (g->temporal) {
+        g->temporal->reset();
+    }
+}
