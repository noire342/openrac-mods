+                "-Wno-unused-value", "-Wno-pointer-to-int-cast", "-Wno-int-to-pointer-cast",
+                "-I", str(RUNTIME_INCLUDE), "-I", str(generated),
+                str(generated / "a.c"), str(driver), "-o", str(executable)],
+                capture_output=True, text=True)
