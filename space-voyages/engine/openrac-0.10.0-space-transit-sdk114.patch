+    for(auto& voice:voices){voice=m.play(&owner,clip,&p);CHECK(voice);}
+    CHECK(!m.play(&owner,clip,&p));
+    for(int i=0;i<100;++i){m.render(out,full);CHECK(m.set(&owner,voices[0],&p));CHECK(m.pause(&owner,true));m.render(out,full);CHECK(silence(out));CHECK(m.pause(&owner,false));}
