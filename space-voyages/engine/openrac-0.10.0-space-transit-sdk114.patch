+    /* Since1.13. Only the active exclusive transient scene's owner may call
+     * these, including closing. Handles0 mean failure; control calls return
+     * HOOK_OK or UNKNOWN. Clips/voices are destroyed automatically on every
+     * scene exit/error. Never retain handles into another lease. The existing
+     * OpenRAC output, global volume/mute/device and native volume groups apply.
+     * The first successful play suspends the origin's host sound timeline;
+     * release resumes it without advancing the frozen game or guest RAM. */
+    uint32_t (*transient_audio_create)(openrac_mod*, const openrac_transient_audio_pcm*);
+    int (*transient_audio_release)(openrac_mod*, uint32_t clip);
+    uint32_t (*transient_audio_play)(openrac_mod*, uint32_t clip, const openrac_transient_audio_params*);
+    int (*transient_audio_set)(openrac_mod*, uint32_t voice, const openrac_transient_audio_params*);
+    int (*transient_audio_stop)(openrac_mod*, uint32_t voice); /*0 stops all voices, not clips */
+    int (*transient_audio_pause)(openrac_mod*, int paused); /*freeze/resume all positions */
+    int (*transient_audio_playing)(openrac_mod*, uint32_t voice); /*1live,0ended/invalid */
+    /* Actual PCM bus counters, not device audibility. out->size set by caller. */
+    int (*transient_audio_stats)(openrac_mod*, openrac_transient_audio_stats* out);
+    /* Since1.14. Game-thread calls only. Read-only lookup by the installed manifest ID, or an explicit
+     * campaign template. current includes the native load generation and the
+     * logical origin captured by an owned departure (never infer it from18).
+     * Set each output size. All controls return HOOK_OK or an error; successful
+     * begin/prepare write a nonzero opaque ticket/token. Failures do not write it.
+     * begin is only at the native ship-computer handoff after boarding, before
+     * the caller invokes the existing native departure initializer. It keeps
+     * that ONE departure in its origin mount; ordinary native menu travel with
+     * no ticket is unchanged. A nonce is nonzero and unique for that departure.
+     * prepare requires that ticket's owner inside its active transient lease.
+     * commit requires the SAME successful lease fully closed, still inside
+     * the native post-take-off continuation. It atomically selects the official
+     * mount and pending native program; it starts no new boarding, departure or
+     * loader. The hook then calls its normal original continuation once.
+     * Without a commit, the continuation retains the logical origin even on
+     * scene error/cancel. cancel is idempotent before consumption. Unload,
+     * context exit and native/registry-generation changes retire pending tokens.
+     * These calls never enable cards or change campaign progression. */
+    int (*destination_lookup)(const char* manifest_id, openrac_destination* out);
+    int (*destination_campaign)(int32_t native_level, openrac_destination* out);
+    int (*destination_current)(openrac_destination_context* out);
+    int (*destination_begin_departure)(openrac_mod*, const openrac_destination_departure*, uint64_t* ticket);
+    int (*destination_prepare)(openrac_mod*, const openrac_destination_request*, uint64_t* token);
+    int (*destination_commit)(openrac_mod*, uint64_t token);
+    int (*destination_cancel)(openrac_mod*, uint64_t ticket_or_token);
 } openrac_api;
 
