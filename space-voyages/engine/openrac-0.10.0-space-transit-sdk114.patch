+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <span>
+#include <vector>
+
+#include "renderer/renderer.h"
+
+namespace openrac::frontend {
+struct EffectOwnerPose {
+    std::uint32_t owner = 0;
+    renderer::Mat4 previous{}, current{}, drawn{};
+    bool blend_local = false;
+};
+
+// Only persistent, explicitly owned surfaces with matching generation/class/topology blend.
+// Local-space blending followed by the displayed actor matrix matches skeletal mesh rendering.
+std::vector<renderer::EffectQuad> blend_attached_effects(
+    std::span<const renderer::EffectQuad> current,
+    std::span<const renderer::EffectQuad> previous,
+    std::span<const EffectOwnerPose> owners,
+    float alpha
+);
+}  // namespace openrac::frontend
