+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Only existing regional host data is touched: no world/mission/save field. */
+#include "rac1.h"
+
+int rac1_destination_departure_ready(void) {
+    const int level = openrac_game_loaded_overlay();
+    if (level < 0 || level >= 19) return 0;
+    /* Boarding cleanup calls PauseAllSounds(0), which enters mode 3, before
+     * opening menu 0xE. Mode 6 still belongs to the preceding cinematic. */
+    return GREF(int, OPENRAC_LDATA(0, RAC1_LADDR(00, 0x0015F6A8u))) == 3 &&
+           GREF(int, OPENRAC_DATA(RAC1_ADDR(0x0013E130u)) + 0x20u) == 0 &&
+           GREF(int, OPENRAC_DATA(RAC1_ADDR(0x001D5F70u))) == 14;
+}
+void rac1_destination_pending(int level) {
+    GREF(int, OPENRAC_DATA(RAC1_ADDR(0x0015F6E4u))) = level;
+}
