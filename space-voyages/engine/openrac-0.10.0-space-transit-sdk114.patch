+// SPDX-License-Identifier: GPL-3.0-or-later
+// Pure ownership/continuation audit: no window, native loader, disc or saves.
+#include "mod_destination.h"
+#include "check.h"
+#include <array>
+#include <cstddef>
+#include <cstring>
+
+using namespace openrac;
+static_assert(offsetof(openrac_api,destination_lookup)==offsetof(openrac_api,transient_audio_stats)+sizeof(void*));
+static_assert(sizeof(openrac_destination_departure)==32 && sizeof(openrac_destination_request)==48);
+namespace {
+std::uint64_t registry=7; std::uint32_t native_generation=12;
+int native_level=18,active=-1,pending=-1,mounts{},stores{}; bool ready=true,exists=true;
+int owner,foreign;
+std::array<unsigned,16> guest{};
+openrac_destination descriptor(bool home){
+    openrac_destination d{};d.size=sizeof d;d.kind=home?OPENRAC_DESTINATION_ADDED:OPENRAC_DESTINATION_CAMPAIGN;
+    d.handle=home?1000:19;d.registry_generation=registry;d.native_level=18;
+    std::snprintf(d.name,sizeof d.name,"%s",home?"Veldin casa":"Veldin");if(home)std::snprintf(d.manifest_id,sizeof d.manifest_id,"veldin-casa");return d;
+}
+int lookup(const char* id,openrac_destination* out){if(!exists||std::strcmp(id,"veldin-casa"))return 0;*out=descriptor(true);return 1;}
+int campaign(int n,openrac_destination* out){if(n<0||n>=19)return 0;*out=descriptor(false);out->handle=unsigned(n)+1;out->native_level=n;return 1;}
+int resolve(std::uint64_t gen,std::uint64_t handle,openrac_destination* out){if(gen!=registry||(handle!=19&&handle!=1000)||(handle==1000&&!exists))return 0;*out=descriptor(handle==1000);return 1;}
+int current(openrac_destination_context* out){out->size=sizeof *out;out->native_generation=native_generation;out->origin=descriptor(active>=0);return 1;}
+int mount(const openrac_destination* d){if(d->registry_generation!=registry)return 0;active=d->kind==OPENRAC_DESTINATION_ADDED?0:-1;++mounts;return 1;}
+void store(int n){pending=n;guest[3]=unsigned(n);++stores;}
+const mods::DestinationHost host{lookup,campaign,resolve,current,+[](){return int(ready);},+[](){return native_level;},+[](){return native_generation;},mount};
+mods::DestinationHandoff handoff;
+std::uint64_t nonce{};
+openrac_destination_context now(){openrac_destination_context c{};c.size=sizeof c;CHECK(handoff.current(&c)==OPENRAC_HOOK_OK);return c;}
+std::uint64_t begin(){auto c=now();openrac_destination_departure r{sizeof r,c.native_generation,c.origin.registry_generation,c.origin.handle,++nonce};std::uint64_t ticket{};CHECK(handoff.begin(&owner,&r,&ticket)==OPENRAC_HOOK_OK&&ticket);return ticket;}
+std::uint64_t enter(){CHECK(handoff.take_departure(native_level,native_generation,1));const auto id=handoff.enter(native_level,native_generation,store);CHECK(id&&id!=mods::DestinationHandoff::refused);return id;}
+std::uint64_t prepare(bool home){auto c=now();openrac_destination_request r{sizeof r,c.native_generation,registry,c.origin.handle,descriptor(home).handle,c.handoff_id,nonce};std::uint64_t token{};CHECK(handoff.prepare(&owner,&r,&token)==OPENRAC_HOOK_OK&&token);return token;}
+void reset(bool home=false){handoff.configure(&host);native_level=18;native_generation=12;registry=7;active=home?0:-1;ready=exists=true;mounts=stores=0;pending=-1;guest.fill(0x12345678);}
+}
+int main(){
+ reset();auto untouched=descriptor(false);untouched.size=0;const auto saved=untouched;
+ CHECK(handoff.lookup("veldin-casa",&untouched)==OPENRAC_HOOK_UNKNOWN&&std::memcmp(&untouched,&saved,sizeof saved)==0);
+ CHECK(handoff.lookup("missing",&untouched)==OPENRAC_HOOK_UNKNOWN);CHECK(handoff.campaign(19,&untouched)==OPENRAC_HOOK_UNKNOWN);
+ CHECK(handoff.enter(18,12,store)==0&&stores==0); // ordinary native UI is untouched
+ auto c=now();std::uint64_t token=123;
+ openrac_destination_departure invalid{sizeof invalid,12,registry,c.origin.handle,1};ready=false;
+ CHECK(handoff.begin(&owner,&invalid,&token)==OPENRAC_HOOK_UNKNOWN&&token==123&&stores==0);ready=true;
+ invalid.native_generation=13;CHECK(handoff.begin(&owner,&invalid,&token)==OPENRAC_HOOK_UNKNOWN&&token==123);
+ const auto ticket=begin();CHECK(handoff.cancel(&foreign,ticket)==OPENRAC_HOOK_UNKNOWN);
+ CHECK(handoff.cancel(&owner,ticket)==OPENRAC_HOOK_OK&&handoff.cancel(&owner,ticket)==OPENRAC_HOOK_OK);
+ CHECK(!handoff.take_departure(18,12,1)&&stores==0&&mounts==0);
+ begin();const auto id=enter();CHECK(stores==1&&pending==18&&active==-1&&mounts==0);
+ CHECK(handoff.enter(18,12,store)==mods::DestinationHandoff::refused);CHECK(!handoff.allow_lease(&foreign));
+ c=now();openrac_destination_request request{sizeof request,12,registry,c.origin.handle,1000,id,nonce};
+ token=123;CHECK(handoff.prepare(&owner,&request,&token)==OPENRAC_HOOK_UNKNOWN&&token==123);
+ handoff.lease_begin(&owner);CHECK(handoff.prepare(&foreign,&request,&token)==OPENRAC_HOOK_UNKNOWN);
+ auto altered=request;++altered.nonce;CHECK(handoff.prepare(&owner,&altered,&token)==OPENRAC_HOOK_UNKNOWN);
+ const auto route=prepare(true);CHECK(handoff.prepare(&owner,&request,&token)==OPENRAC_HOOK_TAKEN);
+ CHECK(handoff.commit(&owner,route)==OPENRAC_HOOK_UNKNOWN&&active==-1); // tick and closing still own lease
+ handoff.lease_end(&owner,true);CHECK(handoff.commit(&foreign,route)==OPENRAC_HOOK_UNKNOWN);
+ const auto memory_before=guest;CHECK(handoff.commit(&owner,route)==OPENRAC_HOOK_OK&&active==0&&pending==18&&mounts==1);
+ for(unsigned i=0;i<guest.size();++i)if(i!=3)CHECK(guest[i]==memory_before[i]);
+ CHECK(handoff.commit(&owner,route)==OPENRAC_HOOK_UNKNOWN&&mounts==1&&stores==2);
+ CHECK(!handoff.allow_lease(&owner));
+ CHECK(handoff.cancel(&owner,route)==OPENRAC_HOOK_UNKNOWN);handoff.leave(id);
+ // Home18 and Campaign18 have the same actual program, but different mounts.
+ begin();const auto from_home=enter();CHECK(now().origin.kind==OPENRAC_DESTINATION_ADDED);
+ handoff.lease_begin(&owner);const auto home_to_final=prepare(false);handoff.lease_end(&owner,true);
+ CHECK(handoff.commit(&owner,home_to_final)==OPENRAC_HOOK_OK&&active==-1&&native_level==18&&native_generation==12);
+ handoff.leave(from_home);
+ // Error, cancel and success without entry must retain the logical Home origin.
+ for(int result:{0,1,2}){
+  reset(true);begin();const auto context=enter();handoff.lease_begin(&owner);
+  const auto maybe=prepare(false);
+  if(result==1)CHECK(handoff.cancel(&owner,maybe)==OPENRAC_HOOK_OK&&handoff.cancel(&owner,maybe)==OPENRAC_HOOK_OK);
+  handoff.lease_end(&owner,result!=0);
+  if(result==0||result==1)CHECK(handoff.commit(&owner,maybe)==OPENRAC_HOOK_UNKNOWN);
+  handoff.leave(context);CHECK(active==0&&pending==18&&mounts==0&&stores==1);
+ }
+ // A new lease cannot consume a token from the previous one.
+ reset();begin();const auto repeated=enter();handoff.lease_begin(&owner);const auto old=prepare(true);
+ handoff.lease_end(&owner,true);handoff.lease_begin(&owner);handoff.lease_end(&owner,true);
+ CHECK(handoff.commit(&owner,old)==OPENRAC_HOOK_UNKNOWN&&mounts==0);handoff.leave(repeated);
+ // Registry/native changes and missing content fail without any mount/program mutation.
+ for(int kind:{0,1,2,3}){
+  reset(true);begin();const auto context=enter();handoff.lease_begin(&owner);const auto route2=prepare(false);
+  handoff.lease_end(&owner,true);if(kind==0)++registry;if(kind==1)++native_generation;if(kind==2)native_level=3;if(kind==3)exists=false;
+  CHECK(handoff.commit(&owner,route2)==OPENRAC_HOOK_UNKNOWN&&mounts==0&&stores==1&&active==0&&pending==18);
+  handoff.leave(context);
+ }
+ reset(true);begin();CHECK(handoff.take_departure(18,12,1));exists=false;
+ CHECK(handoff.enter(18,12,store)==mods::DestinationHandoff::refused&&mounts==0&&stores==0&&active==0);
+ // Unload before take-off leaves native UI alone; after take-off it retains a safe origin continuation.
+ reset(true);begin();handoff.drop(&owner);CHECK(!handoff.take_departure(18,12,1)&&stores==0);
+ begin();CHECK(handoff.take_departure(18,12,1));handoff.drop(&owner);
+ const auto abandoned=handoff.enter(18,12,store);CHECK(abandoned&&abandoned!=mods::DestinationHandoff::refused&&pending==18&&active==0);
+ CHECK(!handoff.allow_lease(&owner));handoff.leave(abandoned);
+ reset();begin();const auto cleanup=enter();handoff.lease_begin(&owner);const auto stale=prepare(true);handoff.drop(&owner);
+ handoff.lease_end(&owner,true);CHECK(handoff.commit(&owner,stale)==OPENRAC_HOOK_UNKNOWN&&mounts==0);handoff.leave(cleanup);
+ // Native same-planet cancellation lands in the current mount and retires its ticket.
+ reset(true);begin();CHECK(handoff.take_departure(18,12,18));
+ CHECK(handoff.enter(18,12,store)==0&&stores==0&&mounts==0&&active==0);begin();
+ // An unconsumed old ticket is retired automatically before the next load's begin.
+ ++native_generation;begin();CHECK(handoff.take_departure(18,native_generation,1));
+ return test::result();
+}
