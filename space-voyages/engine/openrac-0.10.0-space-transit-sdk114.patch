+namespace openrac::frontend {
+constexpr bool continuous_tick(std::uint64_t previous, std::uint64_t current, bool authored_cut) {
+    return current > previous && current - previous == 1 && !authored_cut;
+}
+
+// One discontinuity retires every previous endpoint together. The same
+// helper handles an authored cut and a gap in captured native ticks.
+template <class Snapshot>
