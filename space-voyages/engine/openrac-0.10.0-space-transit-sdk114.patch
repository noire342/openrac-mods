+using openrac::audio::TransientPcm;
+namespace {
+constexpr std::array<std::int32_t,2> full{1024,1024};
+openrac_transient_audio_params params(unsigned flags=0,unsigned group=0){return {sizeof(openrac_transient_audio_params),flags,group,1,1,0};}
+openrac_transient_audio_pcm pcm(const std::int16_t* samples,std::uint64_t frames,std::uint32_t rate=48000,std::uint32_t channels=1){return {sizeof(openrac_transient_audio_pcm),rate,channels,samples,frames,0,0};}
+bool silence(std::span<const std::int16_t> samples){return std::all_of(samples.begin(),samples.end(),[](auto n){return n==0;});}
+void ownership_and_output(){
+    TransientPcm m;int owner=1,other=2;std::array<std::int16_t,6> source{0,1000,2000,3000,4000,5000};
+    const auto view=pcm(source.data(),source.size());auto p=params();
+    CHECK(!m.begin(nullptr)&&m.begin(&owner)&&!m.begin(&other));
+    CHECK(!m.create(&other,TransientPcm::copy(&view)));
+    const auto clip=m.create(&owner,TransientPcm::copy(&view));CHECK(clip&&m.clips()==1&&m.bytes()==12&&!m.takeover());
+    source[1]=123; // Host sample copy is independent of the mod's lifetime/changes.
+    CHECK(!m.play(&other,clip,&p)&&!m.release(&other,clip)&&!m.pause(&other,true));
+    const auto voice=m.play(&owner,clip,&p);CHECK(voice&&m.playing(&owner,voice)&&!m.playing(&other,voice)&&m.takeover());
+    std::array<std::int16_t,4> out{};m.render(out,full);CHECK((out==std::array<std::int16_t,4>{0,0,1000,1000}));
+    openrac_transient_audio_stats stats{};stats.size=sizeof(stats);CHECK(m.stats(&owner,&stats));
+    CHECK(stats.clips==1&&stats.voices==1&&stats.rendered_frames==2&&stats.nonzero_frames==1&&std::abs(stats.peak-1000.f/32768)<1e-7);
+    CHECK(!m.stats(&other,&stats));
+    CHECK(m.pause(&owner,true));std::array<std::int16_t,20> paused{};paused.fill(999);m.render(paused,full);CHECK(silence(paused)&&m.playing(&owner,voice));
