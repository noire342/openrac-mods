+// SPDX-License-Identifier: GPL-3.0-or-later
+// Actual runtime registry adapter on copied host descriptors; no game/window.
+#include "mod_destination.h"
+#include "openrac/game_host.h"
+#include "check.h"
+#include <cstring>
+namespace openrac::program { const mods::DestinationHost* destination_host(); }
+namespace {
+int loaded=18,selected=-1,selects{};unsigned loads=2;
+const openrac_front_end front{.levels=19};
+const openrac_game_play play{.loads=+[](){return loads;},.destination_departure_ready=+[](){return 1;}};
+const openrac_map_config maps[]={
+ {"Other world",18,{1,2,3},0,1,1,"another-world"},
+ {"Veldin casa",18,{4,5,6},0,1,1,"veldin-casa"},
+ {"Also Veldin casa",18,{7,8,9},0,1,1,"other-home"}
+};
+}
+extern "C" {
+const openrac_front_end* openrac_game_front_end=&front;
+const openrac_game_play* openrac_game_play_host=&play;
+const openrac_map_config* openrac_game_destinations=maps;
+unsigned openrac_game_destination_count=3;
+int openrac_game_active_destination=-1;
+const openrac_map_config* openrac_game_map=nullptr;
+uint64_t openrac_game_destination_registry_generation=1;
+int openrac_game_loaded_overlay(){return loaded;}
+void openrac_game_select_destination(int index){selected=index;++selects;openrac_game_active_destination=index;openrac_game_map=index>=0?&maps[index]:nullptr;}
+}
+int main(){
+ const auto* host=openrac::program::destination_host();
+ openrac_destination home{};home.size=sizeof home;
+ CHECK(host->lookup("veldin-casa",&home)&&home.kind==OPENRAC_DESTINATION_ADDED&&home.native_level==18);
+ CHECK(!std::strcmp(home.manifest_id,"veldin-casa")&&home.handle>19&&home.registry_generation==1);
+ openrac_destination other{};other.size=sizeof other;CHECK(host->lookup("other-home",&other)&&other.handle!=home.handle);
+ openrac_destination final{};final.size=sizeof final;CHECK(host->campaign(18,&final)&&final.kind==OPENRAC_DESTINATION_CAMPAIGN&&final.native_level==18&&final.manifest_id[0]==0);
+ CHECK(home.handle!=final.handle&&host->mount(&home)&&selected==1&&selects==1);
+ openrac_destination_context current{};current.size=sizeof current;
+ CHECK(host->current(&current)&&current.origin.handle==home.handle&&current.native_generation==2);
+ CHECK(host->mount(&home)&&selects==1); // same origin: no gratuitous cache generation
+ CHECK(host->mount(&final)&&selected==-1&&selects==2&&openrac_game_map==nullptr);
+ CHECK(host->current(&current)&&current.origin.kind==OPENRAC_DESTINATION_CAMPAIGN);
+ const auto snapshot=home;home.size=0;
+ CHECK(!host->lookup("veldin-casa",&home)&&home.handle==snapshot.handle&&home.size==0);
+ home=snapshot;CHECK(!host->lookup("not-installed",&other));
+ CHECK(!host->campaign(-1,&other)&&!host->campaign(19,&other));
+ ++openrac_game_destination_registry_generation;
+ const int before=selects;CHECK(!host->mount(&home)&&selects==before);
+ CHECK(!host->resolve(home.registry_generation,home.handle,&other));
+ CHECK(host->lookup("veldin-casa",&home)&&home.registry_generation==2);
+ openrac_game_destination_count=1;CHECK(!host->lookup("veldin-casa",&other));
+ CHECK(!host->mount(&home)&&selects==before);openrac_game_destination_count=3;
+ auto forged=home;forged.native_level=3;CHECK(!host->mount(&forged)&&selects==before);
+ forged=home;std::memcpy(forged.manifest_id,"other-home",11);CHECK(!host->mount(&forged)&&selects==before);
+ CHECK(host->mount(&home));loaded=3;CHECK(!host->current(&current));loaded=18;
+ openrac_game_active_destination=-1;openrac_game_map=&maps[0];CHECK(!host->current(&current)); // standalone is not campaign
+ openrac_game_map=nullptr;CHECK(host->ready()&&host->level()==18&&host->generation()==2);
+ return openrac::test::result();
+}
