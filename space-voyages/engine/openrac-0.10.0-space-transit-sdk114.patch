+// SPDX-License-Identifier: GPL-3.0-or-later
+// Compile the actual PAL/NTSC wrappers and shared readiness/pending adapter.
+#include "openrac/game_host.h"
+#include "openrac/memory.h"
+#include "check.h"
+#include <stdexcept>
+#include <vector>
+namespace {int loaded=18,mode{},takes{};std::vector<int> order;}
+extern "C" {
+void func_00233308();void game_FUN_00231ff0();void game_FUN_L00_0028ed58(int);
+int rac1_destination_departure_ready();void rac1_destination_pending(int);
+int openrac_game_loaded_overlay(){return loaded;}uint32_t rac1_program_loads(){return 9;}
+int openrac_mod_destination_departure_taken(int level,uint32_t generation,int target){CHECK(level==18&&generation==9&&target==1);++takes;return mode==1;}
+uint64_t openrac_mod_destination_handoff_begin(int level,uint32_t generation,void(*pending)(int)){
+ CHECK(level==18&&generation==9);order.push_back(1);
+ if(mode==2)return UINT64_MAX;if(mode==1){pending(18);return 31;}return 0;
+}
+void openrac_mod_destination_handoff_end(uint64_t id){CHECK(id==unsigned(mode==1?31:0));order.push_back(3);}
+void func_00233308__hooked(){order.push_back(2);}
+void game_FUN_00231ff0__hooked(){order.push_back(2);}
+void game_FUN_L00_0028ed58__hooked(int target){CHECK(target==1);order.push_back(4);}
+[[noreturn]] void openrac_game_crash(const char*){throw std::runtime_error("refused stale handoff");}
+}
+int main(){
+ using namespace openrac;runtime::Memory::create();
+ // Native boarding cleanup first enters pause/map mode 3 through
+ // PauseAllSounds(0), then sets the ship-computer menu to 0xE. Mode 6 is
+ // the preceding cinematic, not the point where begin_departure is legal.
+ // Actual PAL Batalia capture: loaded=8, mode=3, ship-state=0, menu=14.
+ loaded=8;GREF(int,0x15f6a8)=6;GREF(int,0x13e150)=0;GREF(int,0x1d5f70)=0;
+ CHECK(!rac1_destination_departure_ready());
+ GREF(int,0x15f6a8)=3;CHECK(!rac1_destination_departure_ready());
+ GREF(int,0x1d5f70)=14;CHECK(rac1_destination_departure_ready());
+ // Reject every other mode, ship-state and neighboring menu, including the
+ // closing menu 20; do not relax readiness to any generic paused screen.
+ for(const int level:{-1,0,8,18,19,98,99})for(int game_mode=0;game_mode<9;++game_mode)
+  for(const int ship_state:{-1,0,3,4,8})for(int menu=-1;menu<36;++menu){
+   loaded=level;GREF(int,0x15f6a8)=game_mode;GREF(int,0x13e150)=ship_state;GREF(int,0x1d5f70)=menu;
+   CHECK(bool(rac1_destination_departure_ready())==(level>=0&&level<19&&game_mode==3&&ship_state==0&&menu==14));
+   CHECK(GREF(int,0x15f6a8)==game_mode&&GREF(int,0x13e150)==ship_state&&GREF(int,0x1d5f70)==menu);
+  }
+ loaded=18;
+ GREF(int,0x15ee84)=18;GREF(int,0x15f6e0)=0x12345678;GREF(int,0x15f6e8)=0x24681357;
+ for(auto fn:{func_00233308,game_FUN_00231ff0}){
+  for(mode=0;mode<2;++mode){order.clear();GREF(int,0x15f6e4)=1;fn();CHECK((order==std::vector<int>{1,2,3}));
+   CHECK(GREF(int,0x15f6e4)==(mode==1?18:1));CHECK(GREF(int,0x15ee84)==18&&GREF(int,0x15f6e0)==0x12345678&&GREF(int,0x15f6e8)==0x24681357);}
+  mode=2;order.clear();bool refused=false;try{fn();}catch(const std::runtime_error&){refused=true;}
+  CHECK(refused&&(order==std::vector<int>{1}));
+ }
+ for(mode=0;mode<2;++mode){order.clear();game_FUN_L00_0028ed58(1);CHECK((order==std::vector<int>{4}));}
+ CHECK(takes==2);return test::result();
+}
