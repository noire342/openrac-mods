+    p=params(OPENRAC_TRANSIENT_AUDIO_LOOP);voice=m.play(&owner,stereo_clip,&p);m.render(out,{512,1024});CHECK(out[0]==250&&out[1]==-500); // Native master-volume square law.
+    p.group=1;CHECK(m.set(&owner,voice,&p));m.render(out,{0,1024});CHECK(out[0]==1000&&out[1]==-2000);m.render(out,{1024,0});CHECK(silence(out));
+    CHECK(m.stop(&owner,0));constexpr std::int16_t loud[]={30000};auto loud_view=pcm(loud,1);const auto loud_clip=m.create(&owner,TransientPcm::copy(&loud_view));p=params(OPENRAC_TRANSIENT_AUDIO_LOOP);
