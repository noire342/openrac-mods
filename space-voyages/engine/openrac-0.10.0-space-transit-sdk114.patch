+    CHECK(m.pause(&owner,false));m.render(out,full);CHECK((out==std::array<std::int16_t,4>{2000,2000,3000,3000}));
+    p.flags=OPENRAC_TRANSIENT_AUDIO_PAUSED;CHECK(m.set(&owner,voice,&p));m.render(out,full);CHECK(silence(out));
+    p.flags=0;CHECK(m.set(&owner,voice,&p));m.render(out,full);CHECK((out==std::array<std::int16_t,4>{4000,4000,5000,5000}));CHECK(!m.playing(&owner,voice));
+    m.end(&other);CHECK(m.owns(&owner)&&m.clips()==1);m.end(&owner);CHECK(!m.takeover()&&!m.voices()&&!m.clips()&&!m.bytes());
+    CHECK(m.begin(&owner)&&!m.play(&owner,clip,&p));const auto new_clip=m.create(&owner,TransientPcm::copy(&view));CHECK(new_clip&&new_clip!=clip);m.end(&owner);
+}
+void authored_intro_loop(){
+    int owner=0;TransientPcm m;CHECK(m.begin(&owner));constexpr std::int16_t source[]={0,1000,2000,3000,4000,5000};auto view=pcm(source,6);view.loop_begin_frame=2;view.loop_end_frame=5;
+    auto p=params(OPENRAC_TRANSIENT_AUDIO_LOOP,1);const auto clip=m.create(&owner,TransientPcm::copy(&view)),voice=m.play(&owner,clip,&p);CHECK(voice);
