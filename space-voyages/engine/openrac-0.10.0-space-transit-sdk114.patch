diff --git a/port/tests/cinematic_cut_test.cpp b/port/tests/cinematic_cut_test.cpp
new file mode 100644
index 00000000..34b8bad2
--- /dev/null
+++ b/port/tests/cinematic_cut_test.cpp
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the OpenRAC contributors
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "game/common/frontend/scene_history.h"
+#include "game/common/frontend/state.h"
+#include "game/rac1/game_state.h"
+#include "tests/check.h"
+
+namespace {
+using namespace openrac;
+using game::rac1::CinematicAddresses;
+
+template <class T>
+void put(std::vector<std::uint8_t>& ram, std::uint32_t at, T value) {
+    std::memcpy(ram.data() + at, &value, sizeof value);
+}
+
+constexpr CinematicAddresses addresses{0x10000, 0x11000, 0x12000, 0x13000};
+constexpr std::uint32_t record = 0x14000, frames = record + 0x30;
+
+void prepare(std::vector<std::uint8_t>& ram, const CinematicAddresses& a, int ticks = 96) {
+    std::fill(ram.begin() + record, ram.begin() + record + 4096, 0);
+    put(ram, a.mode, 6);
+    put(ram, a.ship + 0x20, 0);
+    put(ram, a.pal_mode, int(ticks == 80));
+    const int time = ticks == 96 ? 243 : 202, bank = 2, frame = time - bank * ticks;
+    const auto end = std::int16_t(ticks == 96 ? 598 : 498);
+    put(ram, a.playback + 0x34, time);
+    put(ram, a.playback + 0x38, frame);
+    put(ram, a.playback + 0x3C, bank);
+    put(ram, a.playback + 0x40, end);
+    put(ram, a.playback + 0x44, std::int16_t(4));
+    put(ram, a.playback + 0x54, frames);
+    put(ram, a.playback + 0x58, record);
+    put(ram, record, std::uint16_t(end));
+    put(ram, record + 0xC, std::uint16_t(4));
+    put(ram, record + 0x10, std::uint32_t(0x30));
+    put(ram, frames + 32 * frame + 12, std::uint32_t(1));
+    put(ram, frames + 32 * frame + 28, .41421357f);
+}
+
+void memory_guards() {
+    std::vector<std::uint8_t> ram(0x20000);
+    const auto read = [&] {
+        return game::rac1::read_cinematic_cut(ram, addresses);
+    };
+    for (int timing : {80, 96}) {
+        prepare(ram, addresses, timing);
+        CHECK(read());
+        put(ram, addresses.ship + 0x20, 8);
+        CHECK(read());
+        const auto key = frames + 32 * (timing == 96 ? 51 : 42);
+        put(ram, key + 12, std::uint32_t(0));
+        CHECK(!read());
+    }
+    const auto reject = [&](auto mutation) {
+        prepare(ram, addresses);
+        CHECK(read());
+        mutation();
+        CHECK(!read());
+        prepare(ram, addresses);
+        CHECK(read());
+    };
+    for (int mode : {0, 1, 2, 3, 4, 7}) {
+        reject([&] { put(ram, addresses.mode, mode); });
+    }
+    for (int state : {-1, 1, 3, 4, 7, 9}) {
+        reject([&] { put(ram, addresses.ship + 0x20, state); });
+    }
+    for (int timing : {-1, 2, 50, 60}) {
+        reject([&] { put(ram, addresses.pal_mode, timing); });
+    }
+    for (int time : {-1, 242, 244, 598, 599, std::numeric_limits<int>::max()}) {
+        reject([&] { put(ram, addresses.playback + 0x34, time); });
+    }
+    for (int frame : {-1, 50, 52, 96, std::numeric_limits<int>::max()}) {
+        reject([&] { put(ram, addresses.playback + 0x38, frame); });
+    }
+    for (int bank : {-1, 0, 3, 70, std::numeric_limits<int>::max()}) {
+        reject([&] { put(ram, addresses.playback + 0x3C, bank); });
+    }
+    for (std::int16_t count : {std::int16_t(-1), std::int16_t(0), std::int16_t(19)}) {
+        reject([&] { put(ram, addresses.playback + 0x44, count); });
+    }
+    reject([&] { put(ram, record, std::uint16_t(599)); });
+    reject([&] { put(ram, record + 0xC, std::uint16_t(5)); });
+    for (std::uint32_t pointer : {0u, 1u, record + 1, 0x1fff0u, 0xffffffffu}) {
+        reject([&] { put(ram, addresses.playback + 0x58, pointer); });
+        reject([&] { put(ram, addresses.playback + 0x54, pointer); });
+    }
+    for (std::uint32_t offset : {0u, 16u, 0x10000u, 0xffffffffu}) {
+        reject([&] { put(ram, record + 0x10, offset); });
+    }
+    for (unsigned offset : {0u, 4u, 8u, 16u, 20u, 24u, 28u}) {
+        reject([&] {
+            put(ram, frames + 32 * 51 + offset, std::numeric_limits<float>::quiet_NaN());
+        });
+    }
+    reject([&] { put(ram, frames + 32 * 51 + 28, -1.f); });
+    // End cleanup must not inspect the retired bank, even when its stored
+    // pointer now names memory beyond the snapshot (or a once-flagged frame).
+    prepare(ram, addresses);
+    put(ram, addresses.playback + 0x34, 598);
+    put(ram, addresses.playback + 0x58, 0xffffffffu);
+    CHECK(!read());
+    CHECK(!game::rac1::read_cinematic_cut({}, addresses));
+    auto bad = addresses;
+    bad.playback = std::numeric_limits<std::uint32_t>::max();
+    CHECK(!game::rac1::read_cinematic_cut(ram, bad));
+}
+
+std::uint32_t shift = 0;
+
+std::uint32_t relocate(std::uint32_t at) {
+    return at + shift;
+}
+
+std::uint32_t relocate_level(int from, std::uint32_t at) {
+    CHECK(from == 0);
+    return at + shift + 0x10000;
+}
+
+void regional_profiles() {
+    std::vector<std::uint8_t> ram(0x800000);
+    for (const auto version : {"rac1-pal", "rac1-ntsc"}) {
+        const auto& profile = host::game_profile(version);
+        const bool pal = std::strcmp(version, "rac1-pal") == 0;
+        for (auto epoch : {0x100000u, 0x200000u}) {
+            shift = epoch;
+            const CinematicAddresses a{
+                relocate_level(0, pal ? 0x15f6a8u : 0x15f5c4u),
+                relocate(pal ? 0x13e130u : 0x13e030u),
+                relocate(pal ? 0x18cc20u : 0x18cb20u),
+                relocate(pal ? 0x15ee80u : 0x15ed80u)
+            };
+            prepare(ram, a);
+            for (int level = 0; level < 19; ++level) {
+                CHECK(profile.read_state(ram, level, {relocate, relocate_level}).camera_cut);
+            }
+            CHECK(!profile.read_state(ram, -1, {relocate, relocate_level}).camera_cut);
+            CHECK(!profile.read_state(ram, 3).camera_cut);
+            put(ram, a.playback + 0x34, 598);
+            CHECK(!profile.read_state(ram, 3, {relocate, relocate_level}).camera_cut);
+        }
+    }
+}
+
+void snapshot_discontinuity() {
+    using namespace frontend;
+    CHECK(continuous_tick(100, 101, false));
+    CHECK(!continuous_tick(100, 101, true));
+    CHECK(!continuous_tick(100, 102, false));
+    CHECK(!continuous_tick(std::numeric_limits<std::uint64_t>::max(), 0, false));
+    // This is the measured green-ship seek, below both distance/turn heuristic
+    // limits. The heuristic alone therefore does interpolate the two shots.
+    const CameraPose from{{0, 0, 0}, {1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
+    constexpr float cosine = .80149174f;
+    const CameraPose to{
+        {5.294807f, 0, 0},
+        {cosine, std::sqrt(1 - cosine * cosine), 0},
+        {-std::sqrt(1 - cosine * cosine), cosine, 0},
+        {0, 0, 1}
+    };
+    const auto blended = blend_pose(from, to, .5f);
+    CHECK(blended.position[0] > 0 && blended.position[0] < to.position[0]);
+    Kept scene;
+    scene.has_state = scene.has_prev_state = true;
+    scene.state.camera_cut = true;
+    scene.state.camera_position = to.position;
+    scene.prev_state.camera_position = from.position;
+    scene.prev_matrices[1] = renderer::identity();
+    scene.prev_spheres[1] = {1, 2, 3, 4};
+    scene.prev_poses[1] = {0, 1};
+    scene.prev_palette.emplace_back();
+    scene.prev_shadows.emplace_back();
+    scene.prev_shadow_moby = 1;
+    scene.prev_shadow_state.enabled = true;
+    scene.prev_attached_effects.emplace_back();
+    scene.live.emplace_back();
+    scene.palette.emplace_back();
+    scene.effects.emplace_back();
+    scene.camera_epoch = 5;
+    discard_previous_tick(scene);
+    CHECK(!scene.has_prev_state && scene.has_state);
+    CHECK(scene.prev_matrices.empty() && scene.prev_spheres.empty() && scene.prev_poses.empty());
+    CHECK(scene.prev_palette.empty() && scene.prev_shadows.empty() && !scene.prev_shadow_moby);
+    CHECK(!scene.prev_shadow_state.enabled && scene.prev_attached_effects.empty());
+    CHECK(scene.live.size() == 1 && scene.palette.size() == 1 && scene.effects.size() == 1);
+    CHECK(scene.state.camera_position == to.position && scene.camera_epoch == 5);
+    const auto displayed = scene.has_prev_state ? blend_pose(from, to, .5f) : to;
+    CHECK(displayed.position == to.position && displayed.forward == to.forward);
+    // The following ordinary adjacent tick may acquire this exact shot as
+    // its valid endpoint; the discontinuity must not disable future smoothing.
+    CHECK(continuous_tick(101, 102, false));
+}
+
+int inspect_native_capture(char** args) {
+    CinematicAddresses a;
+    const auto parse = [](const char* text, std::uint32_t& value) {
+        const auto end = text + std::strlen(text);
+        const auto result = std::from_chars(text, end, value);
+        return result.ec == std::errc{} && result.ptr == end;
+    };
+    if (!parse(args[3], a.mode) || !parse(args[4], a.ship) || !parse(args[5], a.playback)
+        || !parse(args[6], a.pal_mode)) {
+        std::fprintf(stderr, "Capture addresses must be unsigned decimal32-bit values\n");
+        return 2;
+    }
+    std::vector<std::uint8_t> ram;
+    std::string error;
+    if (!game::rac1::load_memory(args[2], ram, error)) {
+        std::fprintf(stderr, "%s\n", error.c_str());
+        return 2;
+    }
+    const bool actual = game::rac1::read_cinematic_cut(ram, a);
+    if (!actual) {
+        std::fprintf(
+            stderr, "Actual native camera flag was not accepted by the production reader\n"
+        );
+        return 1;
+    }
+    // Acceptance above proved these record fields and the key fit in RAM.
+    const auto read = [&]<class T>(std::uint32_t at) {
+        T value{};
+        std::memcpy(&value, ram.data() + at, sizeof value);
+        return value;
+    };
+    const auto camera = read.operator()<std::uint32_t>(a.playback + 0x54);
+    const auto frame = read.operator()<std::int32_t>(a.playback + 0x38);
+    const auto end = read.operator()<std::int16_t>(a.playback + 0x40);
+    auto flag_zero = ram;
+    put(flag_zero, camera + 32 * std::uint32_t(frame) + 12, std::uint32_t{0});
+    const bool flag_zero_rejected = !game::rac1::read_cinematic_cut(flag_zero, a);
+    auto cleanup = ram;
+    put(cleanup, a.playback + 0x34, std::int32_t(end));
+    put(cleanup, a.playback + 0x58, std::uint32_t{0xffffffff});
+    const bool retired_bank_rejected = !game::rac1::read_cinematic_cut(cleanup, a);
+    const auto previous_failures = test::failures();
+    snapshot_discontinuity();
+    const bool complete_history_reset = test::failures() == previous_failures;
+    CHECK(flag_zero_rejected && retired_bank_rejected && complete_history_reset);
+    std::printf(
+        "{\"actual_native_cut_accepted\":true,"
+        "\"flag_zero_rejected\":%s,\"cleanup_with_retired_bank_rejected\":%s,"
+        "\"complete_history_reset_cpu_test_passed\":%s,"
+        "\"ram_bytes\":%zu,\"guest_ram_written\":false}\n",
+        flag_zero_rejected ? "true" : "false",
+        retired_bank_rejected ? "true" : "false",
+        complete_history_reset ? "true" : "false",
+        ram.size()
+    );
+    return test::result();
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc == 7 && std::strcmp(argv[1], "--ram") == 0) {
+        return inspect_native_capture(argv);
+    }
+    if (argc != 1) {
+        std::fprintf(
+            stderr, "Usage: cinematic_cut_test [--ram file mode ship playback pal_mode]\n"
+        );
+        return 2;
+    }
+    memory_guards();
+    regional_profiles();
+    snapshot_discontinuity();
+    return openrac::test::result();
+}
