diff --git a/port/tests/transient_pacing_test.cpp b/port/tests/transient_pacing_test.cpp
new file mode 100644
index 00000000..d5f6a794
--- /dev/null
+++ b/port/tests/transient_pacing_test.cpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <chrono>
+#include <cmath>
+
+#include "check.h"
+#include "game/common/frontend/transient_pacing.h"
+
+int main() {
+    using namespace openrac::frontend;
+    for (const int hz : {30, 60, 144, 165, 240}) {
+        TransientClock clock;
+        double last = 0, previous = -1;
+        for (int frame = 0; frame < hz; ++frame) {
+            const double now = double(frame) / hz;
+            clock.advance(now - last);
+            last = now;
+            while (clock.due()) {
+                clock.tick();
+            }
+            const float alpha = clock.alpha();
+            CHECK(alpha >= 0 && alpha <= 1);
+            if (clock.ticks() >= 2) {
+                const double shown = (double(clock.ticks()) - 2 + alpha) * TransientClock::step;
+                CHECK(std::abs(shown - (now - TransientClock::step)) < 1e-7);
+                CHECK(previous < 0 || shown >= previous);
+                previous = shown;
+            }
+        }
+        clock.advance((1.0 - 1e-9) - last);
+        while (clock.due()) {
+            clock.tick();
+        }
+        CHECK(clock.ticks() == 60);
+    }
+    TransientClock clock;
+    clock.tick();
+    clock.advance(.5);
+    unsigned catchup = 0;
+    while (clock.due()) {
+        clock.tick();
+        ++catchup;
+    }
+    CHECK(catchup == 6);
+    CHECK(clock.until_tick() > 0);
+    using C = std::chrono::steady_clock;
+    using namespace std::chrono;
+    const auto start = C::time_point(seconds(1));
+    const auto step = milliseconds(16);
+    // Blocking VSync consumes the wait; a second full-period sleep must not be added.
+    CHECK(transient_next_render(start, start, start + step, step) == start + step);
+    // Async Vulkan present still shares the one start-based deadline.
+    CHECK(transient_next_render(start, start, start + milliseconds(1), step) == start + step);
+    // After a stall there is no backlog of presentation deadlines to race through.
+    CHECK(
+        transient_next_render(start, start, start + milliseconds(100), step)
+        == start + milliseconds(100)
+    );
+    return openrac::test::result();
+}
