diff --git a/port/game/common/mod_destination.h b/port/game/common/mod_destination.h
new file mode 100644
index 00000000..3af8db08
--- /dev/null
+++ b/port/game/common/mod_destination.h
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <limits>
+#include "openrac/openrac_mod.h"
+
+namespace openrac::mods {
+// Host registry operations use copied records. mount must finish validation
+// before selecting the official mount, and is only called on the game thread.
+struct DestinationHost {
+    int (*lookup)(const char*, openrac_destination*);
+    int (*campaign)(int, openrac_destination*);
+    int (*resolve)(std::uint64_t, std::uint64_t, openrac_destination*);
+    int (*current)(openrac_destination_context*);
+    int (*ready)();
+    int (*level)();
+    std::uint32_t (*generation)();
+    int (*mount)(const openrac_destination*);
+};
+
+// Bounded, synchronous ownership/state machine; no registry strings, guest
+// addresses, menu rows or allocations are retained by a request.
+class DestinationHandoff {
+public:
+    static constexpr std::uint64_t refused = std::numeric_limits<std::uint64_t>::max();
+    void configure(const DestinationHost* host) { reset(); host_ = host; }
+    void reset() { departure_ = {}; context_ = {}; cancelled_owner_ = nullptr; cancelled_ = 0; }
+
+    int lookup(const char* id, openrac_destination* out) const {
+        if (!host_ || !host_->lookup || !id || !id[0] || !out || out->size < sizeof *out)
+            return OPENRAC_HOOK_UNKNOWN;
+        openrac_destination copy{}; copy.size = sizeof copy;
+        if (!host_->lookup(id, &copy)) return OPENRAC_HOOK_UNKNOWN;
+        *out = copy; return OPENRAC_HOOK_OK;
+    }
+    int campaign(int level, openrac_destination* out) const {
+        if (!host_ || !host_->campaign || !out || out->size < sizeof *out)
+            return OPENRAC_HOOK_UNKNOWN;
+        openrac_destination copy{}; copy.size = sizeof copy;
+        if (!host_->campaign(level, &copy)) return OPENRAC_HOOK_UNKNOWN;
+        *out = copy; return OPENRAC_HOOK_OK;
+    }
+    int current(openrac_destination_context* out) const {
+        if (!out || out->size < sizeof *out || !complete()) return OPENRAC_HOOK_UNKNOWN;
+        openrac_destination_context copy{}; copy.size = sizeof copy;
+        if (context_.id) {
+            if (!fresh(context_.origin, context_.generation, false)) return OPENRAC_HOOK_UNKNOWN;
+            copy.native_generation = context_.generation;
+            copy.handoff_id = context_.id;
+            copy.origin = context_.origin;
+        } else if (!host_->current(&copy)) return OPENRAC_HOOK_UNKNOWN;
+        *out = copy; return OPENRAC_HOOK_OK;
+    }
+    int begin(const void* owner, const openrac_destination_departure* request, std::uint64_t* ticket) {
+        if (!owner || !request || request->size < sizeof *request || !ticket || !complete())
+            return OPENRAC_HOOK_UNKNOWN;
+        if (departure_.stage == 1 && !fresh(departure_.origin, departure_.generation, true)) departure_ = {};
+        if (departure_.stage || context_.id) return OPENRAC_HOOK_TAKEN;
+        openrac_destination_context now{}; now.size = sizeof now;
+        if (!request->nonce || !host_->ready() || !host_->current(&now) ||
+            request->registry_generation != now.origin.registry_generation ||
+            request->origin_handle != now.origin.handle || request->native_generation != now.native_generation ||
+            !fresh(now.origin, now.native_generation, true))
+            return OPENRAC_HOOK_UNKNOWN;
+        const auto id = next(); if (!id) return OPENRAC_HOOK_UNKNOWN;
+        departure_ = {owner, now.origin, now.native_generation, request->nonce, id, 1};
+        *ticket = id; return OPENRAC_HOOK_OK;
+    }
+    // Called only by the native ship-travel wrapper, before its ordinary C
+    // initializer. A false result leaves the official UI behavior unchanged.
+    bool take_departure(int level, std::uint32_t generation, int target) {
+        if (departure_.stage != 1) return false;
+        if (level != departure_.origin.native_level || generation != departure_.generation ||
+            !fresh(departure_.origin, generation, true)) { departure_ = {}; return false; }
+        openrac_destination checked{}; checked.size = sizeof checked;
+        if (!host_->campaign(target, &checked)) { departure_ = {}; return false; }
+        // Backing out to the current planet is the native landing branch,
+        // not a departure awaiting a post-take-off continuation.
+        if (target == level) departure_ = {};
+        else departure_.stage = 2;
+        return true;
+    }
+    // Called around the post-take-off native hook. The pending program is set
+    // to the real origin immediately: no lease, exceptions and abandoned
+    // owners therefore all have the same safe continuation. No mount changes.
+    std::uint64_t enter(int level, std::uint32_t generation, void (*pending)(int)) {
+        if (context_.id) return refused;
+        if (departure_.stage < 2) return 0;
+        if (!pending || level != departure_.origin.native_level || generation != departure_.generation ||
+            !fresh(departure_.origin, generation, true)) { departure_ = {}; return refused; }
+        Context copy{}; copy.owner = departure_.owner; copy.origin = departure_.origin;
+        copy.generation = generation; copy.nonce = departure_.nonce;
+        copy.id = next(); copy.pending = pending;
+        if (!copy.id) return refused;
+        context_ = copy; departure_ = {};
+        pending(copy.origin.native_level);
+        return copy.id;
+    }
+    void leave(std::uint64_t id) { if (id && id != refused && context_.id == id) context_ = {}; }
+    bool allow_lease(const void* owner) const { return !context_.id || (owner && owner == context_.owner && !context_.committed); }
+    void lease_begin(const void* owner) {
+        if (!context_.id || context_.owner != owner) return;
+        context_.lease_owner = owner; context_.lease_open = true; context_.lease_ok = false;
+        context_.prepared = 0; ++context_.lease_epoch;
+    }
+    void lease_end(const void* owner, bool success) {
+        if (!context_.id || context_.lease_owner != owner || !context_.lease_open) return;
+        context_.lease_open = false; context_.lease_ok = success;
+        if (!success) context_.prepared = 0;
+    }
+    int prepare(const void* owner, const openrac_destination_request* request, std::uint64_t* token) {
+        if (!owner || !request || request->size < sizeof *request || !token || !complete())
+            return OPENRAC_HOOK_UNKNOWN;
+        if (context_.owner != owner || context_.lease_owner != owner || !context_.lease_open ||
+            !context_.id || context_.committed || request->handoff_id != context_.id ||
+            request->native_generation != context_.generation || request->nonce != context_.nonce ||
+            request->registry_generation != context_.origin.registry_generation ||
+            request->origin_handle != context_.origin.handle || !fresh(context_.origin, context_.generation, true))
+            return OPENRAC_HOOK_UNKNOWN;
+        if (context_.prepared) return OPENRAC_HOOK_TAKEN;
+        openrac_destination target{}; target.size = sizeof target;
+        if (!host_->resolve(request->registry_generation, request->target_handle, &target))
+            return OPENRAC_HOOK_UNKNOWN;
+        const auto id = next(); if (!id) return OPENRAC_HOOK_UNKNOWN;
+        context_.target = target; context_.prepared = id;
+        context_.prepared_epoch = context_.lease_epoch;
+        *token = id; return OPENRAC_HOOK_OK;
+    }
+    int commit(const void* owner, std::uint64_t token) {
+        if (!owner || !token || !complete() || context_.owner != owner || context_.lease_owner != owner ||
+            !context_.id || context_.lease_open || !context_.lease_ok || context_.prepared != token ||
+            context_.prepared_epoch != context_.lease_epoch || context_.committed ||
+            !fresh(context_.origin, context_.generation, true)) return OPENRAC_HOOK_UNKNOWN;
+        openrac_destination target{}; target.size = sizeof target;
+        if (!host_->resolve(context_.target.registry_generation, context_.target.handle, &target) ||
+            !same(target, context_.target) || !host_->mount(&target)) return OPENRAC_HOOK_UNKNOWN;
+        // mount and this non-failing guest store are consecutive on the game's
+        // thread, with every validation above them. No loader or overlay call.
+        context_.pending(target.native_level);
+        context_.prepared = 0; context_.committed = true;
+        return OPENRAC_HOOK_OK;
+    }
+    int cancel(const void* owner, std::uint64_t token) {
+        if (!owner || !token) return OPENRAC_HOOK_UNKNOWN;
+        if (cancelled_owner_ == owner && cancelled_ == token) return OPENRAC_HOOK_OK;
+        if (departure_.owner == owner && departure_.ticket == token) {
+            if (departure_.stage == 1) departure_ = {};
+            else { departure_.owner = nullptr; departure_.stage = 3; }
+        } else if (context_.owner == owner && context_.prepared == token && !context_.committed) {
+            context_.prepared = 0;
+        } else return OPENRAC_HOOK_UNKNOWN;
+        cancelled_owner_ = owner; cancelled_ = token; return OPENRAC_HOOK_OK;
+    }
+    void drop(const void* owner) {
+        if (departure_.owner == owner) {
+            if (departure_.stage == 1) departure_ = {};
+            else { departure_.owner = nullptr; departure_.stage = 3; }
+        }
+        if (context_.owner == owner) { context_.owner = nullptr; context_.prepared = 0; context_.lease_ok = false; }
+        if (cancelled_owner_ == owner) { cancelled_owner_ = nullptr; cancelled_ = 0; }
+    }
+private:
+    struct Departure {
+        const void* owner{}; openrac_destination origin{};
+        std::uint32_t generation{}; std::uint64_t nonce{}, ticket{}; unsigned stage{};
+    } departure_;
+    struct Context {
+        const void* owner{}; openrac_destination origin{}, target{};
+        std::uint32_t generation{}; std::uint64_t nonce{}, id{}, prepared{}, lease_epoch{}, prepared_epoch{};
+        void (*pending)(int){}; const void* lease_owner{};
+        bool lease_open{}, lease_ok{}, committed{};
+    } context_;
+    const DestinationHost* host_{};
+    std::uint64_t serial_{}, cancelled_{};
+    const void* cancelled_owner_{};
+    std::uint64_t next() { return serial_ < refused - 1 ? ++serial_ : 0; }
+    bool complete() const {
+        return host_ && host_->lookup && host_->campaign && host_->resolve && host_->current && host_->ready && host_->level &&
+               host_->generation && host_->mount;
+    }
+    static bool same(const openrac_destination& a, const openrac_destination& b) {
+        return a.handle == b.handle && a.registry_generation == b.registry_generation &&
+               a.native_level == b.native_level && a.kind == b.kind;
+    }
+    bool fresh(const openrac_destination& origin, std::uint32_t generation, bool require_mount) const {
+        if (!complete() || host_->generation() != generation || host_->level() != origin.native_level) return false;
+        openrac_destination copy{}; copy.size = sizeof copy;
+        if (!host_->resolve(origin.registry_generation, origin.handle, &copy) || !same(copy, origin)) return false;
+        if (!require_mount) return true;
+        openrac_destination_context now{}; now.size = sizeof now;
+        return host_->current(&now) && now.native_generation == generation && same(now.origin, origin);
+    }
+};
+} // namespace openrac::mods
