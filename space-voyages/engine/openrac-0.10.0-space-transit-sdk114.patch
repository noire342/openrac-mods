+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Actual SDK1.14 DLL used by the CPU loader/boundary test. */
+#include "openrac/openrac_mod.h"
+static const openrac_api* api;static openrac_mod* mod;
+static int (*mode)(void);static void (*enter)(void),(*leave)(void),(*record)(int);
+static uint64_t nonce,route;static int failures;
+#define REQUIRE(c) do{if(!(c))++failures;}while(0)
+static int tick(void* u,float seconds,uint16_t held,const uint8_t analog[4]){
+ (void)u;(void)seconds;(void)held;(void)analog;
+ openrac_destination_context c={0};c.size=sizeof c;
+ openrac_destination target={0};target.size=sizeof target;
+ REQUIRE(api->destination_current(&c)==OPENRAC_HOOK_OK&&c.handoff_id);
+ REQUIRE((mode()==4?api->destination_campaign(18,&target):api->destination_lookup("veldin-casa",&target))==OPENRAC_HOOK_OK);
+ openrac_destination_request request={sizeof request,c.native_generation,c.origin.registry_generation,c.origin.handle,target.handle,c.handoff_id,nonce};
+ uint64_t untouched=999;
+ REQUIRE(api->destination_prepare((openrac_mod*)1,&request,&untouched)==OPENRAC_HOOK_UNKNOWN&&untouched==999);
+ REQUIRE(api->destination_prepare(mod,&request,&route)==OPENRAC_HOOK_OK&&route);
+ REQUIRE(api->destination_commit(mod,route)==OPENRAC_HOOK_UNKNOWN);
+ return 0;
+}
+static void draw(void* u,int w,int h){(void)u;(void)w;(void)h;}
+static void closing(void* u){(void)u;REQUIRE(api->destination_commit(mod,route)==OPENRAC_HOOK_UNKNOWN);}
+static void frame(void* u){
+ (void)u;failures=0;route=0;
+ openrac_destination_context c={0};c.size=sizeof c;
+ REQUIRE(api->destination_current(&c)==OPENRAC_HOOK_OK&&c.handoff_id==0);
+ openrac_destination_departure departure={sizeof departure,c.native_generation,c.origin.registry_generation,c.origin.handle,++nonce};
+ uint64_t ticket=999;
+ REQUIRE(api->destination_begin_departure(NULL,&departure,&ticket)==OPENRAC_HOOK_UNKNOWN&&ticket==999);
+ REQUIRE(api->destination_begin_departure(mod,&departure,&ticket)==OPENRAC_HOOK_OK&&ticket!=999);
+ {uint64_t replay=999;REQUIRE(api->destination_begin_departure(mod,&departure,&replay)==OPENRAC_HOOK_UNKNOWN&&replay==999);}
+ enter();
+ openrac_transient_source source={0};source.size=sizeof source;source.tick=tick;source.draw=draw;source.closing=closing;
+ const int result=api->transient_run(mod,&source);
+ if(mode()==0||mode()==4){
+  REQUIRE(result==OPENRAC_HOOK_OK&&api->destination_commit(mod,route)==OPENRAC_HOOK_OK);
+  REQUIRE(api->destination_commit(mod,route)==OPENRAC_HOOK_UNKNOWN);
+ }else if(mode()==3){
+  REQUIRE(result==OPENRAC_HOOK_OK&&api->destination_cancel(mod,route)==OPENRAC_HOOK_OK);
+  REQUIRE(api->destination_cancel(mod,route)==OPENRAC_HOOK_OK);
+ }else REQUIRE(api->destination_commit(mod,route)==OPENRAC_HOOK_UNKNOWN);
+ leave();
+ REQUIRE(api->destination_commit(mod,route)==OPENRAC_HOOK_UNKNOWN);
+ record(failures);
+}
+OPENRAC_MOD_DEFINE("destination-boundary-test","1.0.0")
+OPENRAC_MOD_EXPORT int openrac_mod_load(const openrac_api* host,openrac_mod* owner){
+ api=host;mod=owner;
+ if(api->api_minor<14||api->size<sizeof(openrac_api))return 1;
+ mode=(int(*)(void))api->function("Test_Mode");enter=(void(*)(void))api->function("Test_Enter");
+ leave=(void(*)(void))api->function("Test_Leave");record=(void(*)(int))api->function("Test_Record");
+ if(!mode||!enter||!leave||!record)return 1;
+ return api->on_frame(mod,frame,NULL)==OPENRAC_HOOK_OK?0:1;
+}
