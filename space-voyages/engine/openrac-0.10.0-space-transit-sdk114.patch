+// SPDX-License-Identifier: GPL-3.0-or-later
+// A real SDK1.13 DLL through the actual loader/owner gate, with a recording
+// scene and the actual PCM bus. No window, GPU, device, overlay or game tick.
+#include "mods.h"
+#include "mod_manifest.h"
+#include "audio/transient_pcm.h"
+#include "openrac/guest.h"
+#include "tests/check.h"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+namespace {
+using namespace openrac;
+audio::TransientPcm pcm;
+std::vector<int> records;
+bool throw_scene{};
+void record(int n){records.push_back(n);}
+int begin(const void* owner){return pcm.begin(owner);}void end(const void* owner){pcm.end(owner);}
+std::uint32_t create(const void* owner,const openrac_transient_audio_pcm* p){return pcm.create(owner,audio::TransientPcm::copy(p));}
+int release(const void* owner,std::uint32_t clip){return pcm.release(owner,clip);}
+std::uint32_t play(const void* owner,std::uint32_t clip,const openrac_transient_audio_params* p){return pcm.play(owner,clip,p);}
+int set(const void* owner,std::uint32_t voice,const openrac_transient_audio_params* p){return pcm.set(owner,voice,p);}
+int stop(const void* owner,std::uint32_t voice){return pcm.stop(owner,voice);}int pause(const void* owner,int value){return pcm.pause(owner,value!=0);}
+int playing(const void* owner,std::uint32_t voice){return pcm.playing(owner,voice);}int stats(const void* owner,openrac_transient_audio_stats* p){return pcm.stats(owner,p);}
+const mods::TransientAudioHost backend{begin,end,create,release,play,set,stop,pause,playing,stats};
+int scene(const openrac_transient_source* source){
+    CHECK(mods::transient_active());const std::uint8_t analog[]={128,128,128,128};source->tick(source->user,1.f/60,0,analog);
+    std::array<std::int16_t,8> out{};pcm.render(out,{1024,1024});CHECK(out[0]==1000&&out[6]==4000);
+    if(throw_scene)throw std::runtime_error("deliberate temporary-scene failure");
+    source->closing(source->user);return OPENRAC_HOOK_OK;
+}
+void write(const std::filesystem::path& p,const std::string& s){std::ofstream(p,std::ios::binary)<<s;}
+}
+int main(){
+    namespace fs=std::filesystem;
+    const auto root=fs::temp_directory_path()/std::string("openrac_audio_lease_").append(std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    fs::create_directories(root/"transient-audio-test");
+    const auto library=root/"transient-audio-test"/"test.dll";fs::copy_file(OPENRAC_TEST_AUDIO_MOD,library);
+    write(root/"transient-audio-test"/"openrac-mod.json",std::string(R"({"format":2,"api":"1.13","id":"transient-audio-test","name":"Audio lease CPU test","version":"1.0.0","games":{"test":["one"]},"hooks":[],"plugin":{")")+mods::platform_key()+R"(":"test.dll"}})");
+    write(root/"plugins.json",R"({"format":1,"mods":[{"id":"transient-audio-test","enabled":true,"settings":{}}]})");
+    static const openrac_fn_entry functions[]={{0x100100,reinterpret_cast<openrac_host_fn>(record),"Test_Record"}};openrac_guest_register(OPENRAC_OVERLAY_EXE,functions,1);
+    mods::Host host;host.game="test";host.version="one";host.openrac_version="test";host.list=root/"plugins.json";host.transient_run=scene;host.transient_audio=&backend;
+    CHECK(mods::load(host)=="transient-audio-test 1.0.0");
+    mods::frame();CHECK(records.size()==1&&records.back()==100&&pcm.bytes()==0&&pcm.voices()==0&&!mods::transient_active());
+    throw_scene=true;mods::frame();CHECK(records.size()==2&&records.back()==200&&pcm.bytes()==0&&pcm.voices()==0&&!mods::transient_active());
+    throw_scene=false;mods::frame();CHECK(records.size()==3&&records.back()==100&&pcm.bytes()==0&&!pcm.takeover());
+    mods::reset();fs::remove_all(root);return test::result();
+}
