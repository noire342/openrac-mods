diff --git a/port/game/common/frontend/effect_interpolation.cpp b/port/game/common/frontend/effect_interpolation.cpp
new file mode 100644
index 00000000..bea799d0
--- /dev/null
+++ b/port/game/common/frontend/effect_interpolation.cpp
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "game/common/frontend/effect_interpolation.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <unordered_map>
+
+namespace openrac::frontend {
+namespace {
+using renderer::EffectQuad;
+using renderer::Vec3;
+
+// Invert an affine point in double precision; malformed/singular endpoints never enter history.
+std::optional<Vec3> local_point(const renderer::Mat4& m, const float* p) {
+    if (!std::all_of(m.begin(), m.end(), [](float v) { return std::isfinite(v); }) || m[3] != 0
+        || m[7] != 0 || m[11] != 0 || m[15] != 1) {
+        return {};
+    }
+    const double a = m[0], b = m[4], c = m[8], d = m[1], e = m[5], f = m[9], h = m[2], i = m[6],
+                 j = m[10];
+    const double det = a * (e * j - f * i) - b * (d * j - f * h) + c * (d * i - e * h);
+    if (!std::isfinite(det) || std::abs(det) < 1e-15) {
+        return {};
+    }
+    const double x = double(p[0]) - m[12], y = double(p[1]) - m[13], z = double(p[2]) - m[14];
+    Vec3 out{
+        float(((e * j - f * i) * x + (c * i - b * j) * y + (b * f - c * e) * z) / det),
+        float(((f * h - d * j) * x + (a * j - c * h) * y + (c * d - a * f) * z) / det),
+        float(((d * i - e * h) * x + (b * h - a * i) * y + (a * e - b * d) * z) / det)
+    };
+    if (!std::all_of(out.begin(), out.end(), [](float v) { return std::isfinite(v); })) {
+        return {};
+    }
+    return out;
+}
+
+struct Group {
+    std::vector<const EffectQuad*> parts;
+    bool valid = true;
+};
+
+auto groups(std::span<const EffectQuad> quads) {
+    std::unordered_map<std::uint32_t, Group> out;
+    for (const auto& q : quads) {
+        if (q.owner && q.generation) {
+            out[q.owner].parts.push_back(&q);
+        }
+    }
+    for (auto& [owner, g] : out) {
+        std::vector<const EffectQuad*> ordered(g.parts.size());
+        const auto* first = g.parts.front();
+        for (const auto* q : g.parts) {
+            if (q->part >= ordered.size() || ordered[q->part] || q->generation != first->generation
+                || q->owner_class != first->owner_class) {
+                g.valid = false;
+                break;
+            }
+            ordered[q->part] = q;
+        }
+        if (g.valid) {
+            g.parts = std::move(ordered);
+        }
+    }
+    return out;
+}
+}  // namespace
+
+std::vector<EffectQuad> blend_attached_effects(
+    std::span<const EffectQuad> current,
+    std::span<const EffectQuad> previous,
+    std::span<const EffectOwnerPose> owners,
+    float alpha
+) {
+    std::vector<EffectQuad> out(current.begin(), current.end());
+    if (!(alpha >= 0 && alpha < 1) || previous.empty()) {
+        return out;
+    }
+    const auto now = groups(current), before = groups(previous);
+    for (auto& q : out) {
+        if (!q.owner || !q.generation) {
+            continue;
+        }
+        const auto a = now.find(q.owner), b = before.find(q.owner);
+        const auto pose = std::find_if(owners.begin(), owners.end(), [&](const auto& p) {
+            return p.owner == q.owner;
+        });
+        if (a == now.end() || b == before.end() || !a->second.valid || !b->second.valid
+            || a->second.parts.size() != b->second.parts.size() || pose == owners.end()) {
+            continue;
+        }
+        const auto& from = *b->second.parts[q.part];
+        if (q.generation != from.generation || q.owner_class != from.owner_class) {
+            continue;
+        }
+        auto blended = q;
+        bool valid = true;
+        for (unsigned corner = 0; corner < 4; ++corner) {
+            const auto p = local_point(pose->current, q.corner[corner]);
+            const auto last = local_point(pose->previous, from.corner[corner]);
+            if (!p || !last) {
+                valid = false;
+                break;
+            }
+            auto local = *p;
+            if (pose->blend_local) {
+                for (unsigned c = 0; c < 3; ++c) {
+                    local[c] = (*last)[c] + (local[c] - (*last)[c]) * alpha;
+                }
+            }
+            const auto world = renderer::transform_point(pose->drawn, local);
+            for (unsigned c = 0; c < 3; ++c) {
+                blended.corner[corner][c] = world[c];
+            }
+        }
+        if (valid) {
+            q = blended;
+        }
+    }
+    return out;
+}
+}  // namespace openrac::frontend
