+namespace openrac::program {const mods::DestinationHost* destination_host();}
+namespace {
+using namespace openrac;
+int scenario{},pending=-1,mount_calls{},pending_stores{};unsigned native_generation=5;
+std::uint64_t handoff{};std::vector<int> records;
+const openrac_front_end front{.levels=19};
+const openrac_game_play play{.loads=+[](){return native_generation;},.destination_departure_ready=+[](){return 1;}};
+const openrac_map_config maps[]={{"Veldin casa",18,{0,0,0},0,1,1,"veldin-casa"}};
+int mode(){return scenario;}void record(int n){records.push_back(n);}
+void store(int n){pending=n;++pending_stores;}
+void enter(){
+ CHECK(openrac_mod_destination_departure_taken(18,native_generation,1));
+ CHECK(!openrac_mod_destination_departure_taken(18,native_generation,1));
+ handoff=openrac_mod_destination_handoff_begin(18,native_generation,store);
+ CHECK(handoff&&handoff!=UINT64_MAX&&pending==18);
+}
+void leave(){openrac_mod_destination_handoff_end(handoff);handoff=0;}
+int scene(const openrac_transient_source* source){
+ CHECK(mods::transient_active());const std::uint8_t analog[]={128,128,128,128};
+ source->tick(source->user,1.f/60,0,analog);
+ if(scenario==1)throw std::runtime_error("deliberate named-travel scene error");
+ source->closing(source->user);
+ if(scenario==5)++native_generation;
+ return scenario==2?OPENRAC_HOOK_UNKNOWN:OPENRAC_HOOK_OK;
+}
+void write(const std::filesystem::path& p,const std::string& text){std::ofstream(p,std::ios::binary)<<text;}
+}
+extern "C" {
+const openrac_front_end* openrac_game_front_end=&front;
+const openrac_game_play* openrac_game_play_host=&play;
+const openrac_map_config* openrac_game_destinations=maps;
+unsigned openrac_game_destination_count=1;
+int openrac_game_active_destination=-1;
+const openrac_map_config* openrac_game_map=nullptr;
+uint64_t openrac_game_destination_registry_generation=1;
+int openrac_game_loaded_overlay(){return 18;}
+void openrac_game_select_destination(int index){++mount_calls;openrac_game_active_destination=index;openrac_game_map=index>=0?&maps[index]:nullptr;}
+}
+int main(){
+ namespace fs=std::filesystem;
+ const auto root=fs::temp_directory_path()/std::string("openrac_destination_boundary_").append(std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+ fs::create_directories(root/"destination-boundary-test");
+ fs::copy_file(OPENRAC_TEST_DESTINATION_MOD,root/"destination-boundary-test"/"test.dll");
+ write(root/"destination-boundary-test"/"openrac-mod.json",std::string(R"({"format":2,"api":"1.14","id":"destination-boundary-test","name":"Named travel CPU boundary","version":"1.0.0","games":{"test":["one"]},"hooks":[],"plugin":{")")+mods::platform_key()+R"(":"test.dll"}})");
+ write(root/"plugins.json",R"({"format":1,"mods":[{"id":"destination-boundary-test","enabled":true,"settings":{}}]})");
+ static const openrac_fn_entry functions[]={
+  {0x100100,reinterpret_cast<openrac_host_fn>(mode),"Test_Mode"},
+  {0x100110,reinterpret_cast<openrac_host_fn>(enter),"Test_Enter"},
+  {0x100120,reinterpret_cast<openrac_host_fn>(leave),"Test_Leave"},
+  {0x100130,reinterpret_cast<openrac_host_fn>(record),"Test_Record"}
+ };
+ openrac_guest_register(OPENRAC_OVERLAY_EXE,functions,4);
+ mods::Host host;host.game="test";host.version="one";host.openrac_version="test";host.list=root/"plugins.json";
+ host.transient_run=scene;host.destinations=program::destination_host();
+ CHECK(mods::load(host)=="destination-boundary-test 1.0.0");
+ for(scenario=0;scenario<6;++scenario){
+  const int before=mount_calls;mods::frame();CHECK(records.size()==unsigned(scenario+1)&&records.back()==0);
+  CHECK(!mods::transient_active()&&pending==18&&handoff==0);
+  if(scenario==0)CHECK(openrac_game_active_destination==0&&mount_calls==before+1);
+  if(scenario>=1&&scenario<=3)CHECK(openrac_game_active_destination==0&&mount_calls==before);
+  if(scenario==4)CHECK(openrac_game_active_destination==-1&&mount_calls==before+1);
+  if(scenario==5)CHECK(openrac_game_active_destination==-1&&mount_calls==before);
+ }
+ CHECK(pending_stores==8); //6 safe origins,2 explicit commits; no duplicate program handoffs
+ mods::reset();fs::remove_all(root);return test::result();
+}
