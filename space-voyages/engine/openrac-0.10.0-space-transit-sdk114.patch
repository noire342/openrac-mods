+}
+void invalid_and_bounded_noalloc(){
+    int owner=0;TransientPcm m;CHECK(m.begin(&owner));constexpr std::int16_t sample[]={100,200,300,400};const auto good=pcm(sample,4);auto p=params(OPENRAC_TRANSIENT_AUDIO_LOOP);
+    for(int bad=0;bad<10;++bad){auto view=good;switch(bad){case 0:view.size=0;break;case 1:view.samples=nullptr;break;case 2:view.frames=0;break;case 3:view.frames=UINT64_MAX;break;
+        case 4:view.sample_rate=7999;break;case 5:view.sample_rate=96001;break;case 6:view.channels=3;break;case 7:view.loop_begin_frame=4;break;case 8:view.loop_end_frame=5;break;default:view.loop_begin_frame=2;view.loop_end_frame=1;}
+        CHECK(TransientPcm::copy(&view).samples.empty());}
