diff --git a/port/game/common/program/io_trace.cpp b/port/game/common/program/io_trace.cpp
new file mode 100644
index 00000000..20df2e69
--- /dev/null
+++ b/port/game/common/program/io_trace.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the OpenRAC contributors
+#include <chrono>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <thread>
+
+#include "common/env.h"
+#include "common/log.h"
+#include "openrac/game_host.h"
+#include "openrac/memory.h"
+#include "program/program.h"
+
+namespace openrac::program {
+namespace {
+using Clock = std::chrono::steady_clock;
+
+struct Sample {
+    openrac_io_event event{};
+    std::uint64_t count{};
+    Clock::time_point shown{};
+};
+
+std::thread::id owner;
+Clock::time_point started;
+std::mutex trace_lock;
+std::map<std::string, Sample> samples;
+std::uint64_t lines{};
+
+bool same(const openrac_io_event& a, const openrac_io_event& b) {
+    return a.sector == b.sector && a.count == b.count && a.target == b.target
+           && a.callback == b.callback && a.argument == b.argument && a.result == b.result
+           && a.pending == b.pending && a.error == b.error;
+}
+
+void trace(const openrac_io_event* event) {
+    if (!event || !event->point) {
+        return;
+    }
+    const auto now = Clock::now();
+    std::scoped_lock lock(trace_lock);
+    auto& sample = samples[event->point];
+    ++sample.count;
+    const bool changed = !same(sample.event, *event);
+    const bool loop = std::strcmp(event->point, "fade.loop") == 0
+                      || std::strcmp(event->point, "init.bank.wait.tick") == 0;
+    if (sample.count > 4 && (loop || !changed) && now - sample.shown < std::chrono::seconds(1)) {
+        return;
+    }
+    if (lines >= 8192) {
+        if (lines == 8192) {
+            log::info("io-trace limit reached; later records suppressed");
+        }
+        ++lines;
+        return;
+    }
+    ++lines;
+    sample.event = *event;
+    sample.shown = now;
+    const bool on_owner = std::this_thread::get_id() == owner;
+    int native_level = -999, ship = -999, overlay = -999;
+    char caller[256]{};
+    if (on_owner) {
+        overlay = openrac_game_loaded_overlay();
+        const auto read = [](std::uint32_t address) {
+            int value = -999;
+            if (address && runtime::Memory::get().mapped(address, sizeof value)) {
+                std::memcpy(&value, G(address), sizeof value);
+            }
+            return value;
+        };
+        if (openrac_game_front_end) {
+            native_level = read(openrac_game_front_end->level);
+            ship = read(openrac_game_front_end->ship_state);
+        }
+        openrac_host_caller(0, caller, sizeof caller);
+    }
+    log::info(
+        "io-trace #{} ms={:.3f} host-frame={} native-frame={} overlay={} native-level={} ship={} "
+        "point={} sample={} sector={} count={} target={:#x} callback={:#x} arg={} result={} "
+        "pending={} error={} owner={} caller={}",
+        lines,
+        std::chrono::duration<double, std::milli>(now - started).count(),
+        on_owner ? g_frame : -1L,
+        event->native_frame,
+        overlay,
+        native_level,
+        ship,
+        event->point,
+        sample.count,
+        event->sector,
+        event->count,
+        event->target,
+        event->callback,
+        event->argument,
+        event->result,
+        event->pending,
+        event->error,
+        on_owner,
+        caller
+    );
+}
+}  // namespace
+
+void setup_io_trace() {
+    if (!env::flag(env::Var::TraceCd)) {
+        return;
+    }
+    owner = std::this_thread::get_id();
+    started = Clock::now();
+    openrac_game_io_trace = trace;
+}
+}  // namespace openrac::program
