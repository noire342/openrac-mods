+    unsigned part,
+    const renderer::Mat4& matrix,
+    renderer::Vec3 local
+) {
+    renderer::EffectQuad q{};
+    q.owner = owner;
+    q.generation = generation;
+    q.owner_class = cls;
+    q.part = part;
+    const auto p = renderer::transform_point(matrix, local);
+    for (auto& corner : q.corner) {
+        for (unsigned c = 0; c < 3; ++c) {
+            corner[c] = p[c];
+        }
+        corner[3] = 1;
+    }
+    q.tex0 = 123;
+    q.rgba[0] = 456;
+    return q;
+}
+
+int main() {
+    const auto from = renderer::translation({0, 0, 0});
+    const auto to = renderer::multiply(renderer::translation({2, 1, 0}), renderer::scale(2));
+    EffectOwnerPose pose{42, from, to, frontend::blend_matrix(from, to, .25f), true};
+    auto a = surface(42, 1, 531, 0, from, {1, 2, 3});
+    auto b = surface(42, 1, 531, 0, to, {3, 4, 5});
+    auto particle = surface(0, 0, -1, 0, to, {7, 8, 9});
+    const auto run = [&](std::vector<renderer::EffectQuad> now,
+                         std::vector<renderer::EffectQuad> old) {
+        return frontend::blend_attached_effects(now, old, std::span(&pose, 1), .25f);
+    };
+    auto out = run({particle, b}, {a});
+    const auto expected = renderer::transform_point(pose.drawn, {1.5f, 2.5f, 3.5f});
+    for (unsigned c = 0; c < 3; ++c) {
+        CHECK(std::abs(out[1].corner[0][c] - expected[c]) < 1e-5f);
+    }
+    CHECK(out[0].corner[0][0] == particle.corner[0][0]);
+    CHECK(out[1].tex0 == 123 && out[1].rgba[0] == 456);
+    auto changed = b;
+    changed.generation = 2;
+    CHECK(run({changed}, {a})[0].corner[0][0] == changed.corner[0][0]);
+    changed = b;
+    changed.owner_class = 533;
+    CHECK(run({changed}, {a})[0].corner[0][0] == changed.corner[0][0]);
+    changed = b;
+    changed.part = 1;
+    CHECK(run({b, changed}, {a})[0].corner[0][0] == b.corner[0][0]);
+    CHECK(run({b}, {})[0].corner[0][0] == b.corner[0][0]);
+    CHECK(run({b, b}, {a, a})[0].corner[0][0] == b.corner[0][0]);
+    // A pose discontinuity keeps the current skeleton, while still following the body's draw matrix.
+    pose.blend_local = false;
+    out = run({b}, {a});
+    const auto unblended = renderer::transform_point(pose.drawn, {3, 4, 5});
+    CHECK(std::abs(out[0].corner[0][0] - unblended[0]) < 1e-5f);
+    pose.current = renderer::scale(0);
+    CHECK(run({b}, {a})[0].corner[0][0] == b.corner[0][0]);
+    // Two owners can reorder globally without joining unrelated surfaces.
+    pose.current = to;
+    pose.blend_local = true;
+    auto other = surface(99, 1, 532, 0, to, {9, 8, 7});
+    CHECK(run({other, b}, {a, other})[0].corner[0][0] == other.corner[0][0]);
+    // A rotating/scaling object and a moving local joint use the body's exact matrix product.
+    auto turned = renderer::identity();
+    turned[0] = .8f;
+    turned[1] = .6f;
+    turned[4] = -.6f;
+    turned[5] = .8f;
+    pose.current = renderer::multiply(to, turned);
+    pose.drawn = frontend::blend_matrix(from, pose.current, .25f);
+    b = surface(42, 1, 531, 0, pose.current, {3, 4, 5});
+    out = run({b}, {a});
+    const auto rotated = renderer::transform_point(pose.drawn, {1.5f, 2.5f, 3.5f});
+    for (unsigned c = 0; c < 3; ++c) {
+        CHECK(std::abs(out[0].corner[0][c] - rotated[c]) < 1e-5f);
+    }
+    return openrac::test::result();
+}
