+    for(int bad=0;bad<8;++bad){auto q=p;switch(bad){case 0:q.size=0;break;case 1:q.flags=4;break;case 2:q.group=2;break;case 3:q.gain=NAN;break;case 4:q.gain=4.01f;break;case 5:q.pitch=.24f;break;case 6:q.pitch=4.01f;break;default:q.pan=-1.1f;}
+        CHECK(!m.play(&owner,clip,&q));}
+    std::array<std::uint32_t,64> voices{};std::array<std::int16_t,800> out{};
