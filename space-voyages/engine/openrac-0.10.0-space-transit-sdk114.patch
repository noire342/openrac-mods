+int transient_run(const openrac_transient_source* source) {
+    if (!g || !source || !source->tick || (!source->draw && !source->draw_interpolated)
+        || !finish_render()) {
+        return OPENRAC_HOOK_UNKNOWN;
+    }
+    bool leave = false;
+    int result = OPENRAC_HOOK_OK;
+    {
+        renderer::FrameBuffer target;
+
+        struct Closing {
+            const openrac_transient_source* source;
+
+            void run() {
+                const auto* saved = std::exchange(source, nullptr);
+                if (saved && saved->closing) {
+                    try {
+                        saved->closing(saved->user);
+                    } catch (...) {
+                        log::error("transient scene cleanup threw an exception");
+                    }
+                }
+            }
+
+            ~Closing() { run(); }
+        } closing{source};
+
+        using Clock = std::chrono::steady_clock;
+        using Seconds = std::chrono::duration<double>;
+        const auto origin = Clock::now();
+        auto sampled = origin, next_render = origin, last_present = origin;
+        TransientClock simulation;
+        const bool uncapped = env::flag(env::Var::Uncapped);
+        const bool interpolate = source->draw_interpolated && !one_frame_a_tick()
+                                 && settings::get().frame_rate != settings::FrameRate::Original;
+        const double refresh = g->window->refresh_rate();
+        const auto& options = settings::get();
+        const double asked =
+            options.frame_rate == settings::FrameRate::Capped
+                ? std::clamp(options.frame_cap, settings::kFrameCapMin, settings::kFrameCapMax)
+                : 0;
+        double cap = frame_pacing::limit(
+            asked,
+            options.frame_rate == settings::FrameRate::Display,
+            g->swap != platform::SwapInterval::Immediate,
+            refresh > 20 ? 1.0 / refresh : 0
+        );
+        if (!interpolate) {
+            cap = cap > 0 ? std::min(cap, 60.0) : 60.0;
+        }
+        const auto render_step =
+            cap > 0 ? std::chrono::duration_cast<Clock::duration>(Seconds(1.0 / cap))
+                    : Clock::duration{};
+        std::unique_ptr<std::FILE, decltype(&std::fclose)> trace(nullptr, &std::fclose);
+        if (const auto path = env::value(env::Var::TransientTrace); path && !path->empty()) {
+            trace.reset(std::fopen(std::string(*path).c_str(), "w"));
+            if (trace) {
+                std::setvbuf(trace.get(), nullptr, _IOFBF, 65536);
+                std::fprintf(
+                    trace.get(),
+                    "present,tick,elapsed_ms,dt_ms,ticks,alpha,events_ms,tick_ms,draw_ms,present_"
+                    "ms,wait_ms,late_ms\n"
+                );
+            }
+        }
+        std::uint64_t presents = 0, index = g->index, last_draw = UINT64_MAX;
+        unsigned ticks_since_draw = 0, between_index = 0;
+        double events_ms = 0, tick_ms = 0, wait_ms = 0;
+        const auto millis = [](auto d) {
+            return std::chrono::duration<double, std::milli>(d).count();
+        };
+        log::info(
+            "transient pacing: simulation60Hz, render cap{}Hz, interpolation{}, uncapped{}",
+            cap,
+            interpolate,
+            uncapped
+        );
+        bool presented = false;
+        static const std::uint64_t shot_from = env_frame(env::Var::ShotFrom).value_or(0);
+        try {
+            for (;;) {
+                const auto started = Clock::now();
+                if (uncapped) {
+                    if (!simulation.due()) {
+                        simulation.advance(TransientClock::step);
+                    }
+                } else {
+                    simulation.advance(Seconds(started - sampled).count());
+                }
+                sampled = started;
+                const auto events_started = Clock::now();
+                if (!read_window_events(true)) {
+                    leave = true;
+                    break;
+                }
+                program::watch_sound();
+                events_ms += millis(Clock::now() - events_started);
+                bool finished = false;
+                while (simulation.due()) {
+                    std::uint16_t buttons = 0xffff;
+                    std::uint8_t analog[4]{128, 128, 128, 128};
+                    pad(0, &buttons, analog);
+                    const auto tick_started = Clock::now();
+                    const int running =
+                        source->tick(source->user, 1.f / 60.f, std::uint16_t(~buttons), analog);
+                    tick_ms += millis(Clock::now() - tick_started);
+                    if (!running) {
+                        finished = true;
+                        break;
+                    }
+                    simulation.tick();
+                    index = g->index++;
+                    ++program::g_frame;
+                    program::audio_tick();
+                    ++ticks_since_draw;
+                    if (program::g_options.frames >= 0
+                        && program::g_frame >= program::g_options.frames) {
+                        leave = true;
+                        break;
+                    }
+                    if (uncapped) {
+                        break;
+                    }
+                }
+                if (finished) {
+                    break;
+                }
+                const auto now = Clock::now();
+                const bool render_due = uncapped || cap <= 0 || now >= next_render;
+                if (render_due && (interpolate || ticks_since_draw > 0)) {
+                    const auto draw_started = Clock::now();
+                    int ww = 0, wh = 0;
+                    g->window->drawable_size(ww, wh);
+                    if (ww <= 0 || wh <= 0) {
+                        std::this_thread::sleep_for(std::chrono::milliseconds(16));
+                        continue;
+                    }
+                    const float aspect = picture_aspect(ww, wh);
+                    int width = ww, height = wh;
+                    if (float(width) / float(height) > aspect) {
+                        width = std::clamp(int(std::lround(float(height) * aspect)), 1, ww);
+                    } else {
+                        height = std::clamp(int(std::lround(float(width) / aspect)), 1, wh);
+                    }
+                    if (target.width() != width || target.height() != height) {
+                        std::string error;
+                        if (!target.create(width, height, error)) {
+                            log::error("transient scene framebuffer: {}", error);
+                            result = OPENRAC_HOOK_UNKNOWN;
+                            break;
+                        }
+                    }
+                    gl::glBindFramebuffer(gl::GL_FRAMEBUFFER, target.id());
+                    gl::glViewport(0, 0, width, height);
+                    gl::glDisable(gl::GL_SCISSOR_TEST);
+                    gl::glDepthMask(gl::GL_TRUE);
+                    gl::glClearDepth(1.0);
+                    gl::glClearColor(0.f, 0.f, 0.f, 1.f);
+                    gl::glClear(gl::GL_COLOR_BUFFER_BIT | gl::GL_DEPTH_BUFFER_BIT);
+                    const float alpha = interpolate ? simulation.alpha() : 1.f;
+                    if (source->draw_interpolated) {
+                        source->draw_interpolated(source->user, width, height, alpha);
+                    } else {
+                        source->draw(source->user, width, height);
+                    }
+                    const bool first = last_draw != index;
+                    between_index = first ? 0 : between_index + 1;
+                    last_draw = index;
+                    if ((first || env::flag(env::Var::ShotBetween)) && shots().due(index)
+                        && index >= shot_from) {
+                        const std::string path =
+                            shots().prefix + std::to_string(index)
+                            + (first ? std::string() : "_b" + std::to_string(between_index))
+                            + ".png";
+                        scene::write_png(path, width, height, target.read_rgba());
+                        log::info("transient frame {} written to {}", index, path);
+                    }
+                    const auto present_started = Clock::now();
+                    present(target.resolved(), width, height, ww, wh, false, aspect);
+                    draw_touch_pad(ww, wh);
+                    g->window->swap();
+                    presented = true;
+                    const auto shown = Clock::now();
+                    if (trace) {
+                        std::fprintf(
+                            trace.get(),
+                            "%llu,%llu,%.6f,%.6f,%u,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f\n",
+                            (unsigned long long)presents,
+                            (unsigned long long)simulation.ticks(),
+                            millis(shown - origin),
+                            millis(shown - last_present),
+                            ticks_since_draw,
+                            alpha,
+                            events_ms,
+                            tick_ms,
+                            millis(present_started - draw_started),
+                            millis(shown - present_started),
+                            wait_ms,
+                            std::max(0.0, millis(draw_started - next_render))
+                        );
+                    }
+                    ++presents;
+                    last_present = shown;
+                    ticks_since_draw = 0;
+                    events_ms = tick_ms = wait_ms = 0;
+                    if (cap > 0) {
+                        next_render =
+                            transient_next_render(next_render, draw_started, shown, render_step);
+                    }
+                }
+                if (leave) {
+                    break;
+                }
+                if (!uncapped) {
+                    auto due = sampled
+                               + std::chrono::duration_cast<Clock::duration>(
+                                   Seconds(simulation.until_tick())
+                               );
+                    if (interpolate || ticks_since_draw > 0) {
+                        due = cap > 0 ? std::min(due, next_render) : Clock::now();
+                    }
+                    const auto wait_started = Clock::now();
+                    if (due > wait_started) {
+                        std::this_thread::sleep_until(due);
+                    }
+                    wait_ms += millis(Clock::now() - wait_started);
+                }
+            }
+        } catch (const std::exception& error) {
+            log::error("transient scene: {}", error.what());
+            result = OPENRAC_HOOK_UNKNOWN;
+        } catch (...) {
+            log::error("transient scene: unknown callback exception");
+            result = OPENRAC_HOOK_UNKNOWN;
+        }
+        if (presented && !leave) {
+            try {
+                retain_transient_picture(target);
+            } catch (const std::exception& error) {
+                log::error("transient scene handoff: {}", error.what());
+                result = OPENRAC_HOOK_UNKNOWN;
+            }
+        }
+        closing.run();
+        mods::finish_transient_audio();
+        gl::glBindVertexArray(0);
+        gl::glUseProgram(0);
+        gl::glActiveTexture(gl::GL_TEXTURE0);
+        gl::glBindTexture(gl::GL_TEXTURE_2D, 0);
+        gl::glBindSampler(0, 0);
+        gl::glBindFramebuffer(gl::GL_FRAMEBUFFER, 0);
+        gl::glDepthMask(gl::GL_TRUE);
+        gl::glClearDepth(0.0);
+        gl::glDepthFunc(gl::GL_GREATER);
+        gl::glDisable(gl::GL_SCISSOR_TEST);
+        gl::glDisable(gl::GL_BLEND);
+        // Never interpolate the last native frame across time spent in the scene.
+        g->prepared_tick.reset();
+        g->kept->has_prev_state = false;
+        program::g_next_frame = {};
+    }
+    if (leave) {
+        program::leave();
+    }
+    return result;
+}
