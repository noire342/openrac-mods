diff --git a/port/tools/hostgen/test_boot_only_calls.py b/port/tools/hostgen/test_boot_only_calls.py
new file mode 100644
index 00000000..95dc4be0
--- /dev/null
+++ b/port/tools/hostgen/test_boot_only_calls.py
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Named executable-only casts must not become an overlay address lookup.
+
+The fixture reproduces the PAL Kalebo collision with an int(int) executable
+helper and a void(int,int,int,int,int) level function at the same address.
+It runs the actual translated C with a colliding lookup and also checks that
+literal and explicitly named level calls still reach the level function.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+import clangast
+import hostgen
+
+HERE = Path(__file__).resolve().parent
+RUNTIME_INCLUDE = HERE.parent.parent / "runtime/include"
+
+
+class BootOnlyCalls(unittest.TestCase):
+    def test_named_cast_preserves_executable_identity_and_overlay_calls(self):
+        try:
+            clang = clangast.clang_binary()
+        except SystemExit:
+            self.skipTest("hostgen's configured Clang is unavailable")
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source = root / "game"
+            (source / "src").mkdir(parents=True)
+            (source / "src/a.c").write_text(
+                'extern int ticks(int) __asm__("func_001F98C0");\n'
+                'extern void frame(int,int,int,int,int) __asm__("func_L16_001F98C0");\n'
+                'extern int mix(int,float) __asm__("func_001F9900");\n'
+                'extern void test_ui(int,int,int,int,int);\n'
+                'int func_001F98C0(int n) { return n; }\n'
+                'int func_001F9900(int n, float x) { return n + (int)x; }\n'
+                'void func_L16_001F98C0(int a,int b,int c,int d,int e) { test_ui(a,b,c,d,e); }\n'
+                'int func_00232278(void) { return ((int (*)(int))ticks)(12); }\n'
+                'int func_002322A0(void) { return ((int (*)(float,int))mix)(2.0f, 10); }\n'
+                'void func_L16_00300000(void) { ((void (*)(int,int,int,int,int))frame)(1,2,3,4,5); }\n'
+                'void func_L16_00300040(void) { ((void (*)(int,int,int,int,int))0x001F98C0)(6,7,8,9,10); }\n',
+                encoding="utf-8")
+            (source / "functions.tsv").write_text(
+                'func_00232278\texe\t1704\tfingerprint\t2\t03:0027F8B0,16:0028BE40\n'
+                'func_002322A0\texe\t32\tfingerprint\t2\t03:0027FFA0,16:0028C000\n'
+                'func_L16_001F98C0\tl16\t324\tfingerprint\t1\t16:001F98C0\n'
+                'func_L16_00300000\tl16\t32\tfingerprint\t1\t16:00300000\n'
+                'func_L16_00300040\tl16\t32\tfingerprint\t1\t16:00300040\n',
+                encoding="utf-8")
+            config = {"sources": ["src"], "includes": [], "places": "functions.tsv",
+                      "host_functions": ["test_ui"], "relocate": [0x15F000, 0x400000]}
+            (root / "hostgen.json").write_text(json.dumps(config), encoding="utf-8")
+            generated = root / "gen"
+            self.assertEqual(hostgen.main([
+                "--game", str(root / "hostgen.json"), "--source", str(source),
+                "--out", str(generated), "--jobs", "1", "--quiet"]), 0)
+            translated = (generated / "a.c").read_text()
+            self.assertIn("func_001F98C0(", translated)
+            self.assertNotIn("OPENRAC_CODE(0x001F98C0u)", translated)
+            self.assertNotIn("OPENRAC_CODE(0x001F9900u)", translated)
+            # Two legitimate level calls still go through guest address lookup.
+            self.assertEqual(translated.count("GFN(void (*)(int, int, int, int, int), "), 2, translated)
+            driver = root / "driver.c"
+            driver.write_text(
+                '#include <stdio.h>\n#include "openrac/guest.h"\n#include "game_protos.h"\n'
+                'gaddr openrac_relocate_low=0x15F000, openrac_relocate_high=0x400000;\n'
+                'static int lookups, ui_calls, bad_args;\n'
+                'gaddr openrac_relocate_code(gaddr a) { return a; }\n'
+                'openrac_host_fn openrac_guest_function(gaddr a) {\n'
+                ' ++lookups; if(a!=0x1F98C0) { bad_args=1; return 0; }\n'
+                ' return (openrac_host_fn)func_L16_001F98C0; }\n'
+                'void game_test_ui(int a,int b,int c,int d,int e) {\n'
+                ' ++ui_calls; if(!((a==1&&b==2&&c==3&&d==4&&e==5)||'
+                '(a==6&&b==7&&c==8&&d==9&&e==10))) bad_args=1; }\n'
+                'int main(void) {\n'
+                ' int n=func_00232278(), mixed=func_002322A0();\n'
+                ' func_L16_00300000(); func_L16_00300040();\n'
+                ' if(n!=12||mixed!=12||lookups!=2||ui_calls!=2||bad_args) return 1;\n'
+                ' puts("boot-only casts12; reordered ABI12; overlay lookups2/UIcalls2"); return 0; }\n',
+                encoding="utf-8")
+            executable = root / ("fixture.exe" if os.name == "nt" else "fixture")
+            build = subprocess.run([
