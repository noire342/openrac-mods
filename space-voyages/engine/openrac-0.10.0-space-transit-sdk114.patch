diff --git a/port/game/common/frontend/transient_pacing.h b/port/game/common/frontend/transient_pacing.h
new file mode 100644
index 00000000..f7675341
--- /dev/null
+++ b/port/game/common/frontend/transient_pacing.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+
+namespace openrac::frontend {
+// Simulation is independent of presentation. Long stalls discard wall time beyond100ms;
+// each accepted update remains exactly one native60Hz tick, with at most6catch-up ticks.
+class TransientClock {
+public:
+    static constexpr double step = 1.0 / 60.0;
+
+    void advance(double elapsed) {
+        accumulator_ = std::min(.1, accumulator_ + std::clamp(elapsed, 0.0, .1));
+    }
+
+    bool due() const { return accumulator_ + 1e-12 >= step; }
+
+    void tick() {
+        accumulator_ = std::max(0.0, accumulator_ - step);
+        ++ticks_;
+    }
+
+    float alpha() const {
+        return ticks_ < 2 ? 1.f : float(std::clamp(accumulator_ / step, 0.0, 1.0));
+    }
+
+    double until_tick() const { return std::max(0.0, step - accumulator_); }
+
+    std::uint64_t ticks() const { return ticks_; }
+
+private:
+    double accumulator_ = step;
+    std::uint64_t ticks_ = 0;
+};
+
+inline std::chrono::steady_clock::time_point transient_next_render(
+    std::chrono::steady_clock::time_point previous,
+    std::chrono::steady_clock::time_point started,
+    std::chrono::steady_clock::time_point finished,
+    std::chrono::steady_clock::duration step
+) {
+    const auto due = previous.time_since_epoch().count() == 0 ? started + step : previous + step;
+    return finished > due + step ? finished : due;
+}
+}  // namespace openrac::frontend
