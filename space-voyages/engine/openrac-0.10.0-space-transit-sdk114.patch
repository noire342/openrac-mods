diff --git a/port/audio/transient_pcm.cpp b/port/audio/transient_pcm.cpp
new file mode 100644
index 00000000..1271831a
--- /dev/null
+++ b/port/audio/transient_pcm.cpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "audio/transient_pcm.h"
+#include <algorithm>
+#include <cmath>
+
+namespace openrac::audio {
+TransientPcm::Prepared TransientPcm::copy(const openrac_transient_audio_pcm* src){
+    if(!src||src->size<sizeof(*src)||!src->samples||!src->frames||src->sample_rate<8000||src->sample_rate>96000||
+       (src->channels!=1&&src->channels!=2)||src->frames>std::uint64_t(src->sample_rate)*600||
+       src->frames>byte_budget/(src->channels*sizeof(std::int16_t)))return {};
+    const auto end=src->loop_end_frame?src->loop_end_frame:src->frames;
+    if(end>src->frames||src->loop_begin_frame>=end)return {};
+    Prepared out;out.rate=src->sample_rate;out.channels=src->channels;out.frames=src->frames;
+    out.loop_begin=src->loop_begin_frame;out.loop_end=end;
+    out.samples.assign(src->samples,src->samples+std::size_t(src->frames*src->channels));return out;
+}
+bool TransientPcm::begin(const void* owner)noexcept{
+    if(!owner||owner_)return false;owner_=owner;paused_=takeover_=false;rendered_frames_=nonzero_frames_=0;peak_=0;return true;
+}
+void TransientPcm::end(const void* owner)noexcept{
+    if(!owns(owner))return;
+    voices_={};for(auto& c:clips_){c.id=0;c.pcm=Prepared{};}bytes_=0;owner_=nullptr;paused_=takeover_=false;
+}
+std::uint32_t TransientPcm::id()noexcept{if(!next_id_)++next_id_;return next_id_++;}
+TransientPcm::Clip* TransientPcm::clip(std::uint32_t value)noexcept{
+    if(!value)return nullptr;for(auto& c:clips_)if(c.id==value)return &c;return nullptr;
+}
+std::uint32_t TransientPcm::create(const void* owner,Prepared pcm){
+    const auto bytes=pcm.samples.size()*sizeof(std::int16_t);
+    if(!owns(owner)||pcm.samples.empty()||!pcm.frames||pcm.rate<8000||pcm.rate>96000||
+       (pcm.channels!=1&&pcm.channels!=2)||pcm.frames>std::uint64_t(pcm.rate)*600||
+       pcm.frames>byte_budget/(pcm.channels*sizeof(std::int16_t))||pcm.samples.size()!=pcm.frames*pcm.channels||
+       pcm.loop_begin>=pcm.loop_end||pcm.loop_end>pcm.frames||bytes>byte_budget-bytes_)return 0;
+    for(auto& c:clips_)if(!c.id){c.pcm=std::move(pcm);c.id=id();bytes_+=bytes;return c.id;}return 0;
+}
+bool TransientPcm::release(const void* owner,std::uint32_t value)noexcept{
+    if(!owns(owner))return false;auto* c=clip(value);if(!c)return false;
+    for(auto& v:voices_)if(v.clip==value)v={};bytes_-=c->pcm.samples.size()*sizeof(std::int16_t);*c={};return true;
+}
+bool TransientPcm::valid(const openrac_transient_audio_params* p)noexcept{
+    return p&&p->size>=sizeof(*p)&&!(p->flags&~std::uint32_t(OPENRAC_TRANSIENT_AUDIO_LOOP|OPENRAC_TRANSIENT_AUDIO_PAUSED))&&
+        p->group<=1&&std::isfinite(p->gain)&&p->gain>=0&&p->gain<=4&&std::isfinite(p->pitch)&&p->pitch>=.25f&&p->pitch<=4&&
+        std::isfinite(p->pan)&&p->pan>=-1&&p->pan<=1;
+}
+std::uint32_t TransientPcm::play(const void* owner,std::uint32_t value,const openrac_transient_audio_params* params)noexcept{
+    auto* c=clip(value);if(!owns(owner)||!c||!valid(params))return 0;
+    for(auto& v:voices_)if(!v.id){v={id(),value,std::size_t(c-clips_.data()),0,*params};takeover_=true;return v.id;}return 0;
+}
+bool TransientPcm::set(const void* owner,std::uint32_t value,const openrac_transient_audio_params* params)noexcept{
+    if(!owns(owner)||!value||!valid(params))return false;
+    for(auto& v:voices_)if(v.id==value){v.params=*params;return true;}return false;
+}
+bool TransientPcm::stop(const void* owner,std::uint32_t value)noexcept{
+    if(!owns(owner))return false;bool found=value==0;
+    for(auto& v:voices_)if(!value||v.id==value){found=found||v.id!=0;v={};}return found;
+}
+bool TransientPcm::pause(const void* owner,bool value)noexcept{if(!owns(owner))return false;paused_=value;return true;}
+bool TransientPcm::playing(const void* owner,std::uint32_t value)const noexcept{
+    if(!owns(owner)||!value)return false;for(const auto& v:voices_)if(v.id==value)return true;return false;
+}
+std::size_t TransientPcm::clips()const noexcept{std::size_t n=0;for(const auto& c:clips_)n+=c.id!=0;return n;}
+std::size_t TransientPcm::voices()const noexcept{std::size_t n=0;for(const auto& v:voices_)n+=v.id!=0;return n;}
+bool TransientPcm::stats(const void* owner,openrac_transient_audio_stats* out)const noexcept{
+    if(!owns(owner)||!out||out->size<sizeof(*out))return false;
+    *out={sizeof(*out),std::uint32_t(clips()),std::uint32_t(voices()),std::uint32_t(paused_),rendered_frames_,nonzero_frames_,peak_};return true;
+}
+void TransientPcm::render(std::span<std::int16_t> out,const std::array<std::int32_t,2>& master)noexcept{
+    if(!takeover_)return;
+    rendered_frames_+=out.size()/2;std::fill(out.begin(),out.end(),0);if(paused_)return;
+    const auto group_gain=[](std::int32_t m){const double g=std::clamp(double(m)/1024.,0.,4.);return g*g;};
+    const std::array<double,2> gains{group_gain(master[0]),group_gain(master[1])};
+    for(std::size_t f=0;f+1<out.size();f+=2){double left=0,right=0;
+        for(auto& v:voices_)if(v.id&&!(v.params.flags&OPENRAC_TRANSIENT_AUDIO_PAUSED)){
+            const auto& c=clips_[v.clip_slot];if(c.id!=v.clip){v={};continue;}const auto& pcm=c.pcm;
+            const bool loop=(v.params.flags&OPENRAC_TRANSIENT_AUDIO_LOOP)!=0;
+            const auto end=loop?pcm.loop_end:pcm.frames;
+            if(v.position>=double(end)){
+                if(!loop){v={};continue;}
+                v.position=double(pcm.loop_begin)+std::fmod(v.position-double(pcm.loop_begin),double(end-pcm.loop_begin));
+            }
+            const auto at=std::uint64_t(v.position),next=at+1<end?at+1:loop?pcm.loop_begin:at;
+            const double fraction=v.position-double(at),gain=double(v.params.gain)*gains[v.params.group];
+            const auto sample=[&](std::uint32_t channel){const auto a=pcm.samples[std::size_t(at*pcm.channels+channel)],b=pcm.samples[std::size_t(next*pcm.channels+channel)];return double(a)+(double(b)-a)*fraction;};
+            left+=sample(0)*gain*(v.params.pan>0?1-v.params.pan:1);
+            right+=sample(pcm.channels==2?1:0)*gain*(v.params.pan<0?1+v.params.pan:1);
+            v.position+=double(pcm.rate)/48000.*v.params.pitch;
+            if(!loop&&v.position>=double(pcm.frames))v={};
+        }
+        out[f]=std::int16_t(std::clamp(left,-32768.,32767.));out[f+1]=std::int16_t(std::clamp(right,-32768.,32767.));
+        if(out[f]||out[f+1])++nonzero_frames_;
+        peak_=std::max(peak_,float(std::max(std::abs(int(out[f])),std::abs(int(out[f+1]))))/32768.f);
+    }
+}
+}
diff --git a/port/audio/transient_pcm.h b/port/audio/transient_pcm.h
new file mode 100644
index 00000000..34d7a45e
--- /dev/null
+++ b/port/audio/transient_pcm.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <span>
+#include <vector>
+#include "openrac/openrac_mod.h"
+
+namespace openrac::audio {
+// A bounded PCM bus in the existing sound engine, not a device or game driver.
+// Like SoundPlayer, calls and render are serialized by sound_engine's g_lock.
+class TransientPcm final {
+public:
+    static constexpr std::size_t clip_capacity=16,voice_capacity=64;
+    static constexpr std::size_t byte_budget=256u*1024*1024;
+    struct Prepared {
+        std::vector<std::int16_t> samples;
+        std::uint32_t rate{},channels{};
+        std::uint64_t frames{},loop_begin{},loop_end{};
+    };
+    // Copy may allocate; run it outside the realtime mixer's lock, then adopt.
+    static Prepared copy(const openrac_transient_audio_pcm*);
+    bool begin(const void* owner)noexcept;
+    void end(const void* owner)noexcept;
+    std::uint32_t create(const void* owner,Prepared);
+    bool release(const void* owner,std::uint32_t clip)noexcept;
+    std::uint32_t play(const void* owner,std::uint32_t clip,const openrac_transient_audio_params*)noexcept;
+    bool set(const void* owner,std::uint32_t voice,const openrac_transient_audio_params*)noexcept;
+    bool stop(const void* owner,std::uint32_t voice)noexcept;
+    bool pause(const void* owner,bool paused)noexcept;
+    bool playing(const void* owner,std::uint32_t voice)const noexcept;
+    bool stats(const void* owner,openrac_transient_audio_stats*)const noexcept;
+    bool owns(const void* owner)const noexcept{return owner&&owner==owner_;}
+    bool takeover()const noexcept{return takeover_;}
+    // Replaces native audio only after this scene first plays PCM. The native
+    // SoundPlayer and native stream positions stay untouched during takeover.
+    void render(std::span<std::int16_t> stereo,const std::array<std::int32_t,2>& master)noexcept;
+    std::size_t bytes()const noexcept{return bytes_;}
+    std::size_t clips()const noexcept;
+    std::size_t voices()const noexcept;
+private:
+    struct Clip {std::uint32_t id{};Prepared pcm;};
+    struct Voice {std::uint32_t id{},clip{};std::size_t clip_slot{};double position{};openrac_transient_audio_params params{};};
+    std::array<Clip,clip_capacity> clips_{};
+    std::array<Voice,voice_capacity> voices_{};
+    const void* owner_{};
+    std::size_t bytes_{};
+    std::uint32_t next_id_=1;
+    bool paused_{},takeover_{};
+    std::uint64_t rendered_frames_{},nonzero_frames_{};
+    float peak_{};
+    static bool valid(const openrac_transient_audio_params*)noexcept;
+    std::uint32_t id()noexcept;
+    Clip* clip(std::uint32_t)noexcept;
+};
+}
