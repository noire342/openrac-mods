diff --git a/sdk/include/openrac/openrac_mod.h b/sdk/include/openrac/openrac_mod.h
index 1c39e280..eed2047f 100644
--- a/sdk/include/openrac/openrac_mod.h
+++ b/sdk/include/openrac/openrac_mod.h
@@ -53,7 +53,7 @@ extern "C" {
  * update with the hero standing in for another player, hits watched and posted, eyes that keep
  * mobys running, and the bolts, 1.10 optional top-level desktop menu entries for mods.
  */
-#define OPENRAC_MOD_API_MINOR 10
+#define OPENRAC_MOD_API_MINOR 14
 
 /* The interface a mod is built for, what its openrac_mod_query reports: its manifest's "api" minor,
  * which the SDK's openrac_add_mod passes in, else this header's. A mod for 1.1 built with a newer
@@ -904,6 +904,85 @@ typedef void (*openrac_pad_fn)(void* user, int port, uint8_t* report, int size);
 /* What the port offers a mod. Filled by the port; valid for the life of the program. Every function
  * is called on the game's thread. Members from "1.2" on are at the end: a mod built for 1.1 never
  * sees them, and one built for 1.2 loads on a 1.2 port or newer. */
+/* A synchronous temporary scene owned by one mod, since 1.11. The game and
+ * other mods do not tick. tick gets fixed 1/60 seconds, active-HIGH PS2 bits
+ * (Cross 0x4000, Triangle 0x1000, Start 8) and RX, RY, LX, LY. Return 1 to keep
+ * running or 0 to finish. draw has a cleared framebuffer and viewport bound.
+ * Only transient_gl_proc entry points may draw here (GL and Vulkan compatible).
+ * closing runs once with the context before transient_run returns, on errors
+ * too. Source is borrowed synchronously; no callbacks survive the call. */
+typedef struct openrac_transient_source {
+    uint32_t size;
+    void* user;
+    int (*tick)(void* user, float seconds, uint16_t held, const uint8_t analog[4]);
+    void (*draw)(void* user, int width, int height);
+    void (*closing)(void* user);
+    /* Since1.12, optional: render between fixed ticks. alpha blends the owner's previous and
+     * current tick snapshots(0..1); first state and Original/Uncapped drawing use1. */
+    void (*draw_interpolated)(void* user, int width, int height, float alpha);
+} openrac_transient_source;
+
+/* Since1.13: PCM owned by the current temporary scene. Create copies signed16
+ * interleaved samples (mono/stereo,8000..96000Hz). frames counts channel frames,
+ * not individual samples. At most16 clips,64 voices,256MiB total;600s per clip.
+ * No native overlay, game-memory write or separate sound device is involved. */
+typedef struct openrac_transient_audio_pcm {
+    uint32_t size;
+    uint32_t sample_rate;
+    uint32_t channels;
+    const int16_t* samples;
+    uint64_t frames;
+    uint64_t loop_begin_frame;
+    uint64_t loop_end_frame; /*exclusive;0 means frames. Intro[0,begin) plays once. */
+} openrac_transient_audio_pcm;
+enum {
+    OPENRAC_TRANSIENT_AUDIO_LOOP = 1,
+    OPENRAC_TRANSIENT_AUDIO_PAUSED = 2,
+    OPENRAC_TRANSIENT_AUDIO_EFFECTS = 0,
+    OPENRAC_TRANSIENT_AUDIO_MUSIC = 1
+};
+typedef struct openrac_transient_audio_params {
+    uint32_t size;
+    uint32_t flags; /* LOOP/PAUSED only */
+    uint32_t group; /* EFFECTS or MUSIC, the game's existing volume groups */
+    float gain;    /*0..4,1=original PCM gain */
+    float pitch;   /*.25..4,1=original sample rate */
+    float pan;     /*-1left..0center..1right, centered stereo preserved */
+} openrac_transient_audio_params;
+typedef struct openrac_transient_audio_stats {
+    uint32_t size;
+    uint32_t clips, voices, paused;
+    uint64_t rendered_frames, nonzero_frames;
+    float peak; /*0..1, mixed PCM after native groups BEFORE global output gain */
+} openrac_transient_audio_stats;
+
+/* Since1.14: an installed destination is distinct from its native template.
