@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+
+#include "mod_transient.h"
+static_assert(OPENRAC_MOD_API_MINOR == 14);
+static_assert(offsetof(openrac_api,transient_audio_create)==offsetof(openrac_api,transient_gl_proc)+sizeof(void*));
+static_assert(
+    offsetof(openrac_api, transient_run)
+    == offsetof(openrac_api, developer_menu_set_label) + sizeof(void*)
+);
+
+int main() {
+    using openrac::mods::TransientLease;
+    int count = 0;
+    auto check = [&](bool value) {
+        ++count;
+        if (!value) {
+            std::exit(1);
+        }
+    };
+    TransientLease lease;
+    int owner = 0, other = 1;
+    openrac_transient_source source{};
+    source.size = sizeof source;
+    source.tick = +[](void*, float, std::uint16_t, const std::uint8_t*) {
+        return 0;
+    };
+    source.draw = +[](void*, int, int) {
+    };
+    check(!lease.active());
+    check(!lease.acquire(nullptr, &source));
+    check(!lease.acquire(&owner, nullptr));
+    auto invalid = source;
+    invalid.tick = nullptr;
+    check(!lease.acquire(&owner, &invalid));
+    invalid = source;
+    invalid.draw = nullptr;
+    check(!lease.acquire(&owner, &invalid));
+    invalid = source;
+    invalid.size = offsetof(openrac_transient_source, draw_interpolated) - 1;
+    check(!lease.acquire(&owner, &invalid));
+    check(lease.acquire(&owner, &source));
+    check(lease.active());
+    check(lease.owns(&owner)&&!lease.owns(&other)&&!lease.owns(nullptr));
+    check(!lease.acquire(&owner, &source));
+    check(!lease.acquire(&other, &source));
+    auto tick = source.tick;
+    source.tick = nullptr;
+    check(lease.source().tick == tick);
+    lease.release();
+    check(!lease.active());
+    check(!lease.source().tick);
+    auto legacy = source;
+    legacy.tick = tick;
+    legacy.size = offsetof(openrac_transient_source, draw_interpolated);
+    legacy.draw_interpolated = +[](void*, int, int, float) {
+    };
+    check(lease.acquire(&owner, &legacy));
+    check(lease.source().draw_interpolated == nullptr);
+    lease.release();
+    legacy.size = offsetof(openrac_transient_source, draw_interpolated) + 1;
+    check(lease.acquire(&owner, &legacy));
+    check(lease.source().draw_interpolated == nullptr);
+    lease.release();
+    legacy.size = sizeof legacy;
+    legacy.draw = nullptr;
+    check(lease.acquire(&owner, &legacy));
+    check(lease.source().draw_interpolated != nullptr);
+    lease.release();
+    source.tick = tick;
+    check(lease.acquire(&other, &source));
+    lease.release();
+    check(!lease.active());
+    std::printf("transient lease: %d checks passed\n", count);
+}
