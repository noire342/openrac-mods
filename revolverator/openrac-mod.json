  },
  "settings": [
    {
      "key": "start_unlocked",
      "name": "Rotatore sbloccato da subito",
      "description": "Assegna il Rotatore con 20 munizioni alla prima fase giocabile se non e gia posseduto. Non ripristina le munizioni ai successivi caricamenti.",
      "type": "bool",
      "default": false
    },
    {
      "key": "hud",
      "name": "Show charge inside the native weapon HUD",
      "type": "bool",
      "default": true
    },
    {
      "key": "reduced_motion",
      "name": "Reduce weapon presentation motion",
      "type": "bool",
      "default": false
    },
    {
      "key": "trace",
      "name": "Diagnostic logging",
      "type": "bool",
      "default": false
    }
  ]
