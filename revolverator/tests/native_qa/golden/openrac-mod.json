{
  "format": 2,
  "id": "golden-native-probe",
  "name": "Isolated Golden Revolverator native QA",
  "version": "0.1.0",
  "api": "1.3",
  "license": "GPL-3.0-or-later",
  "games": {
    "rac1": [
      "ntsc"
    ]
  },
  "load": {
    "after": [
      "weapon-xp",
      "revolverator"
    ]
  },
  "hooks": [
    "rac1.pad.process_report",
    "rac1.combat.get_hit",
    "rac1.moby.record_death",
    "rac1.moby.moby180.update",
    "rac1.moby.item_offer.update",
    "rac1.player.update_motion_input",
    "rac1.player.set_planar_velocity",
    "rac1.level.load_gameplay"
  ],
  "settings": [
    {
      "key": "mode",
      "name": "QA scenario",
      "type": "string",
      "default": "shop"
    },
    {
      "key": "deadline",
      "name": "Fixture frame deadline",
      "type": "int",
      "default": 2200,
      "min": 300,
      "max": 36000
    },
    {
      "key": "require_xp",
      "name": "Require independent earned XP proof",
      "type": "bool",
      "default": true
    }
  ]
}
