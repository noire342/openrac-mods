* text=auto
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.tsv text eol=lf
arsenal-compat/third_party/minhook/** text eol=lf
arsenal-file-overlay/third_party/minhook/** text eol=lf
*.png binary
*.glb binary
*.wav binary
# Preserve byte-exact source evidence and build recipes pinned by native QA.
revolverator/assets/audio/source/manifest-original.json -text whitespace=cr-at-eol
revolverator/assets/audio/LICENSE-GPL-3.0.txt -text whitespace=cr-at-eol
revolverator/CMakeLists.txt -text whitespace=cr-at-eol
revolverator/support/file-overlay/CMakeLists.txt -text whitespace=cr-at-eol
revolverator/support/file-overlay/third_party/minhook/CMakeLists.txt -text whitespace=cr-at-eol,-blank-at-eol
revolverator/tests/native_qa/golden/CMakeLists.txt -text whitespace=cr-at-eol
revolverator/third_party/minhook/CMakeLists.txt -text whitespace=cr-at-eol,-blank-at-eol
